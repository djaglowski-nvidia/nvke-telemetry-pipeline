# Local dev loop: NKTP chart on the local Kind cluster.
# Start with `task dev:up`.
# Or from dev/: KUBECONFIG=.kubeconfig tilt up [-- --config <name>]

load('ext://helm_resource', 'helm_resource', 'helm_repo')
load('ext://k8s_attach', 'k8s_attach')

config.define_string('config')
cfg = config.parse()
dev_config = cfg.get('config', '')

kube_context = 'kind-nktp'
namespace = 'nktp'

allow_k8s_contexts(kube_context)
watch_settings(ignore = ['../nktp/charts', '../nktp/tmpcharts-*'])

helm_repo('open-telemetry', 'https://open-telemetry.github.io/opentelemetry-helm-charts')
helm_repo('prometheus-community', 'https://prometheus-community.github.io/helm-charts', resource_deps = ['open-telemetry'])

# Kind uses runtime journals. Named configs layer on top of these host paths.
value_files = ['values.yaml']
watch_file('values.yaml')
if dev_config:
    config_dir = 'configs/%s' % dev_config
    local('test -f "%s/values.yaml" || { echo "error: config not found: %s/values.yaml" >&2; exit 1; }' % (config_dir, config_dir))
    watch_file(config_dir)
    value_files += ['%s/values.yaml' % config_dir]
    value_files += sorted([f for f in listdir(config_dir) if f.endswith('.yaml') and not f.endswith('/values.yaml')])

local(
    'kubectl --context %s create namespace %s --dry-run=client -o yaml | kubectl --context %s apply -f -'
    % (kube_context, namespace, kube_context)
)

# NKTP Helm release with the selected dev config overlay.
helm_resource(
    'nktp',
    chart = '../nktp',
    namespace = namespace,
    deps = ['../nktp'],
    flags = ['--values=' + f for f in value_files],
    build_dependencies = True,
    resource_deps = ['open-telemetry', 'prometheus-community'],
    labels = ['nktp'],
)

k8s_attach(
    'grafana',
    'deployment/lgtm',
    namespace = namespace,
    port_forwards = ['3000:3000'],
    resource_deps = ['nktp'],
    labels = ['nktp'],
)
