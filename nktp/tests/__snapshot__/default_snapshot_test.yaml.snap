                      {
                        "displayName": "Samples",
                        "desc": true
                      }
                    ]
                  },
                  "transformations": [
                    {
                      "id": "joinByField",
                      "options": {
                        "byField": "target",
                        "mode": "outerTabular"
                      }
                    },
                    {
                      "id": "organize",
                      "options": {
                        "excludeByName": {
                          "Time": true,
                          "Time 1": true,
                          "Time 2": true,
                          "Time 3": true
                        },
                        "indexByName": {
                          "target": 0,
                          "Value #D": 1,
                          "Value #A": 2,
                          "Value #B": 3,
                          "Value #C": 4
                        },
                        "renameByName": {
                          "target": "Target",
                          "Value #A": "Samples",
                          "Value #B": "Sample growth",
                          "Value #C": "Scrape duration",
                          "Value #D": "Up"
                        }
                      }
                    }
                  ]
