            {
              "id": 11,
              "type": "timeseries",
              "title": "Traces flow",
              "description": "Traces items per second at each Collector role. Each hop is shown separately. Do not sum the roles as unique traffic or interpret received minus sent as loss. Idle components can have no samples.",
              "gridPos": {
                "x": 16,
                "y": 25,
                "w": 8,
                "h": 8
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${metrics}"
              },
              "targets": [
                {
                  "expr": "sum by (job) (rate(otelcol_receiver_accepted_spans_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval]))",
                  "legendFormat": "{{job}} received",
                  "refId": "A",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                },
                {
                  "expr": "sum by (job) (rate(otelcol_exporter_sent_spans_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval]))",
                  "legendFormat": "{{job}} sent",
                  "refId": "B",
                  "range": true,
                  "instant": false,
                  "interval": "1m"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "suffix:spans/s",
                  "min": 0,
                  "noValue": "Unknown",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        }
                      }
                    }
                  ],
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 8,
                    "showPoints": "never",
                    "spanNulls": false,
                    "axisBorderShow": false
                  }
                },
                "overrides": []
              },
              "transformations": [
                {
                  "id": "renameByRegex",
                  "options": {
                    "regex": "^nktp-",
                    "renamePattern": ""
                  }
                }
              ],
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": [
                    "lastNotNull"
                  ],
                  "height": 110
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            {
              "id": 42,
              "type": "row",
              "title": "Backpressure and export delay",
              "collapsed": true,
              "gridPos": {
                "x": 0,
                "y": 33,
                "w": 24,
                "h": 1
              },
              "panels": [
                {
                  "id": 14,
                  "type": "timeseries",
                  "title": "Pipeline queues by replica \u00b7 top 20",
                  "description": "Queues block on overflow. Sustained congestion can cause upstream refusals or timeouts. Compare the busiest replica, not a fleet average. These queues do not include native internal telemetry exporters. Shows up to 20 series with the highest value at the end of the selected range.",
                  "gridPos": {
                    "x": 0,
                    "y": 34,
                    "w": 24,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "(100 * otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} / otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}) and on (job, instance, exporter, data_type) topk(20, 100 * otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} @ end() / otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} @ end())",
                      "legendFormat": "{{instance}} \u00b7 {{exporter}} \u00b7 {{data_type}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "percent",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 39,
                  "type": "table",
                  "title": "Busiest exporter queues \u00b7 top 20",
                  "description": "Current queue pressure per replica, exporter and signal. NKTP defaults size these queues in serialized bytes. Queue accounting includes in-flight payloads. In-flight counts active export requests, including retry backoff. If the queue sizer is overridden, size and capacity use that configured unit.",
                  "gridPos": {
                    "x": 0,
                    "y": 42,
                    "w": 24,
                    "h": 9
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "max by (target) (label_join((100 * otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} / otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}) and on (job, instance, exporter, data_type) (topk(20, 100 * otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} / otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"})), \"target\", \" \u00b7 \", \"instance\", \"exporter\", \"data_type\"))",
                      "instant": true,
                      "range": false,
                      "format": "table",
                      "refId": "A"
                    },
                    {
                      "expr": "max by (target) (label_join((otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}) and on (job, instance, exporter, data_type) (topk(20, 100 * otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} / otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"})), \"target\", \" \u00b7 \", \"instance\", \"exporter\", \"data_type\"))",
                      "instant": true,
                      "range": false,
                      "format": "table",
                      "refId": "B"
                    },
                    {
                      "expr": "max by (target) (label_join((otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}) and on (job, instance, exporter, data_type) (topk(20, 100 * otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} / otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"})), \"target\", \" \u00b7 \", \"instance\", \"exporter\", \"data_type\"))",
                      "instant": true,
                      "range": false,
                      "format": "table",
                      "refId": "C"
                    },
                    {
                      "expr": "max by (target) (label_join((otelcol_exporter_in_flight_requests{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}) and on (job, instance, exporter, data_type) (topk(20, 100 * otelcol_exporter_queue_size{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} / otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"})), \"target\", \" \u00b7 \", \"instance\", \"exporter\", \"data_type\"))",
                      "instant": true,
                      "range": false,
                      "format": "table",
                      "refId": "D"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "short",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ]
                    },
                    "overrides": [
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Target"
                        },
                        "properties": [
                          {
                            "id": "custom.width",
                            "value": 650
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Queue use"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "percent"
                          },
                          {
                            "id": "custom.width",
                            "value": 100
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Used bytes"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "bytes"
                          },
                          {
                            "id": "custom.width",
                            "value": 100
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Capacity"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "bytes"
                          },
                          {
                            "id": "custom.width",
                            "value": 100
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "In flight"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "short"
                          },
                          {
                            "id": "custom.width",
                            "value": 100
                          }
                        ]
                      }
                    ]
                  },
                  "options": {
                    "showHeader": true,
                    "cellHeight": "sm",
                    "footer": {
                      "show": false
                    },
                    "sortBy": [
                      {
                        "displayName": "Queue use",
                        "desc": true
                      }
                    ]
                  },
                  "transformations": [
                    {
                      "id": "joinByField",
                      "options": {
                        "byField": "target",
                        "mode": "outerTabular"
                      }
                    },
                    {
                      "id": "organize",
                      "options": {
                        "excludeByName": {
                          "Time": true,
                          "Time 1": true,
                          "Time 2": true,
                          "Time 3": true
                        },
                        "indexByName": {
                          "target": 0,
                          "Value #A": 1,
                          "Value #B": 2,
                          "Value #C": 3,
                          "Value #D": 4
                        },
                        "renameByName": {
                          "target": "Target",
                          "Value #A": "Queue use",
                          "Value #B": "Used bytes",
                          "Value #C": "Capacity",
                          "Value #D": "In flight"
                        }
                      }
                    }
                  ]
                },
                {
                  "id": 40,
                  "type": "timeseries",
                  "title": "Longest completed export",
                  "description": "Longest observed pipeline export span per time bucket, across replicas of each role. Includes sending and retry backoff. Excludes queue residence and batching before the export starts. Uses completed internal spans, so an export still in progress is not represented. Requires Tempo TraceQL metrics.",
                  "gridPos": {
                    "x": 0,
                    "y": 51,
                    "w": 12,
                    "h": 8
                  },
                  "datasource": {
                    "type": "tempo",
                    "uid": "${traces}"
                  },
                  "targets": [
                    {
                      "refId": "A",
                      "queryType": "traceql",
                      "metricsQueryType": "range",
                      "query": "{ resource.service.name =~ \"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\" && name =~ \"exporter/.*/.*\" } | max_over_time(duration) by (resource.service.name, span:name)"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "s",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^\\{name=\"([^\"]+)\", resource.service.name=\"nktp-([^\"]+)\"\\}$",
                        "renamePattern": "$2 \u00b7 $1"
                      }
                    },
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^\\{resource.service.name=\"nktp-([^\"]+)\"\\}$",
                        "renamePattern": "$1"
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "table",
                      "placement": "bottom",
                      "calcs": [
                        "max"
                      ],
                      "sortBy": "Max",
                      "sortDesc": true,
                      "height": 110
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 41,
                  "type": "timeseries",
                  "title": "Queue admission delay",
                  "description": "Longest observed call to enter an exporter queue, across replicas of each role. Includes blocking while a queue is full. Does not measure time spent waiting after admission. Uses completed internal spans and requires Tempo TraceQL metrics.",
                  "gridPos": {
                    "x": 12,
                    "y": 51,
                    "w": 12,
                    "h": 8
                  },
                  "datasource": {
                    "type": "tempo",
                    "uid": "${traces}"
                  },
                  "targets": [
                    {
                      "refId": "A",
                      "queryType": "traceql",
                      "metricsQueryType": "range",
                      "query": "{ resource.service.name =~ \"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\" && name = \"exporter/enqueue\" } | max_over_time(duration) by (resource.service.name)"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "s",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^\\{name=\"([^\"]+)\", resource.service.name=\"nktp-([^\"]+)\"\\}$",
                        "renamePattern": "$2 \u00b7 $1"
                      }
                    },
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^\\{resource.service.name=\"nktp-([^\"]+)\"\\}$",
                        "renamePattern": "$1"
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "table",
                      "placement": "bottom",
                      "calcs": [
                        "max"
                      ],
                      "sortBy": "Max",
                      "sortDesc": true,
                      "height": 110
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                }
              ]
            },
            {
              "id": 16,
              "type": "row",
              "title": "Container resources, Collector processes and autoscaling",
              "collapsed": true,
              "gridPos": {
                "x": 0,
                "y": 34,
                "w": 24,
                "h": 1
              },
              "panels": [
                {
                  "id": 47,
                  "type": "table",
                  "title": "Container CPU budgets \u00b7 up to 3 per component",
                  "description": "Kubernetes requests and limits in the selected namespace. Shows up to 3 containers per component, ranked by request or by limit when no request is reported. Container inventory retains components without budgets. Missing budget values may be unset or unavailable.",
                  "gridPos": {
                    "x": 0,
                    "y": 35,
                    "w": 24,
                    "h": 14
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "max by (target) (label_join((max by (namespace, pod, container) (kube_pod_container_info{namespace=\"$namespace\",pod=~\"(nktp-daemonset-collector|nktp-cluster-events-collector|nktp-gateway-logs-collector|nktp-gateway-metrics-collector|nktp-gateway-traces-collector|nktp-large-target-metrics-collector|nktp-watchdog-collector|nktp-daemonset-targetallocator|nktp-large-target-metrics-targetallocator|nktp-watchdog-targetallocator|nktp-operator|nktp-ksm-pods|nktp-ksm-unscheduled-pods|nktp-ksm-cluster|nktp-ksm-workloads|nktp-ksm-configuration|nktp-ksm-networking|nktp-ksm-storage|nktp-node-exporter|nktp-metrics-server|metrics-server|lgtm)(-.*)?\",pod=~\"(${component:regex})(-.*)?\",container!=\"\",container!=\"POD\"})) and on (namespace, pod, container) (topk by (component) (3, label_replace(((max by (namespace, pod, container) (kube_pod_container_resource_requests{namespace=\"$namespace\",pod=~\"(nktp-daemonset-collector|nktp-cluster-events-collector|nktp-gateway-logs-collector|nktp-gateway-metrics-collector|nktp-gateway-traces-collector|nktp-large-target-metrics-collector|nktp-watchdog-collector|nktp-daemonset-targetallocator|nktp-large-target-metrics-targetallocator|nktp-watchdog-targetallocator|nktp-operator|nktp-ksm-pods|nktp-ksm-unscheduled-pods|nktp-ksm-cluster|nktp-ksm-workloads|nktp-ksm-configuration|nktp-ksm-networking|nktp-ksm-storage|nktp-node-exporter|nktp-metrics-server|metrics-server|lgtm)(-.*)?\",pod=~\"(${component:regex})(-.*)?\",container!=\"\",container!=\"POD\",resource=\"cpu\"})) or (max by (namespace, pod, container) (kube_pod_container_resource_limits{namespace=\"$namespace\",pod=~\"(nktp-daemonset-collector|nktp-cluster-events-collector|nktp-gateway-logs-collector|nktp-gateway-metrics-collector|nktp-gateway-traces-collector|nktp-large-target-metrics-collector|nktp-watchdog-collector|nktp-daemonset-targetallocator|nktp-large-target-metrics-targetallocator|nktp-watchdog-targetallocator|nktp-operator|nktp-ksm-pods|nktp-ksm-unscheduled-pods|nktp-ksm-cluster|nktp-ksm-workloads|nktp-ksm-configuration|nktp-ksm-networking|nktp-ksm-storage|nktp-node-exporter|nktp-metrics-server|metrics-server|lgtm)(-.*)?\",pod=~\"(${component:regex})(-.*)?\",container!=\"\",container!=\"POD\",resource=\"cpu\"})) or (0 * (max by (namespace, pod, container) (kube_pod_container_info{namespace=\"$namespace\",pod=~\"(nktp-daemonset-collector|nktp-cluster-events-collector|nktp-gateway-logs-collector|nktp-gateway-metrics-collector|nktp-gateway-traces-collector|nktp-large-target-metrics-collector|nktp-watchdog-collector|nktp-daemonset-targetallocator|nktp-large-target-metrics-targetallocator|nktp-watchdog-targetallocator|nktp-operator|nktp-ksm-pods|nktp-ksm-unscheduled-pods|nktp-ksm-cluster|nktp-ksm-workloads|nktp-ksm-configuration|nktp-ksm-networking|nktp-ksm-storage|nktp-node-exporter|nktp-metrics-server|metrics-server|lgtm)(-.*)?\",pod=~\"(${component:regex})(-.*)?\",container!=\"\",container!=\"POD\"})))) and on (namespace, pod, container) (max by (namespace, pod, container) (kube_pod_container_info{namespace=\"$namespace\",pod=~\"(nktp-daemonset-collector|nktp-cluster-events-collector|nktp-gateway-logs-collector|nktp-gateway-metrics-collector|nktp-gateway-traces-collector|nktp-large-target-metrics-collector|nktp-watchdog-collector|nktp-daemonset-targetallocator|nktp-large-target-metrics-targetallocator|nktp-watchdog-targetallocator|nktp-operator|nktp-ksm-pods|nktp-ksm-unscheduled-pods|nktp-ksm-cluster|nktp-ksm-workloads|nktp-ksm-configuration|nktp-ksm-networking|nktp-ksm-storage|nktp-node-exporter|nktp-metrics-server|metrics-server|lgtm)(-.*)?\",pod=~\"(${component:regex})(-.*)?\",container!=\"\",container!=\"POD\"})), \"component\", \"$1\", \"pod\", \"(nktp-daemonset-collector|nktp-cluster-events-collector|nktp-gateway-logs-collector|nktp-gateway-metrics-collector|nktp-gateway-traces-collector|nktp-large-target-metrics-collector|nktp-watchdog-collector|nktp-daemonset-targetallocator|nktp-large-target-metrics-targetallocator|nktp-watchdog-targetallocator|nktp-operator|nktp-ksm-pods|nktp-ksm-unscheduled-pods|nktp-ksm-cluster|nktp-ksm-workloads|nktp-ksm-configuration|nktp-ksm-networking|nktp-ksm-storage|nktp-node-exporter|nktp-metrics-server|metrics-server|lgtm)(-.*)?\"))), \"target\", \" / \", \"pod\", \"container\"))",
                      "refId": "A",
                      "instant": true,
                      "range": false,
                      "interval": "1m",
                      "legendFormat": "",
                      "format": "table"
