                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "short",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ]
                    },
                    "overrides": [
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Target"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "string"
                          },
                          {
                            "id": "custom.width",
                            "value": 650
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Request"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "bytes"
                          },
                          {
                            "id": "custom.width",
                            "value": 170
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Limit"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "bytes"
                          },
                          {
                            "id": "custom.width",
                            "value": 170
                          }
                        ]
                      }
                    ]
                  },
                  "options": {
                    "showHeader": true,
                    "cellHeight": "sm",
                    "footer": {
                      "show": false
                    },
                    "sortBy": [
                      {
                        "displayName": "Request",
                        "desc": true
                      },
                      {
                        "displayName": "Limit",
                        "desc": true
                      },
                      {
                        "displayName": "Target",
                        "desc": false
                      }
                    ]
                  },
                  "transformations": [
                    {
                      "id": "joinByField",
                      "options": {
                        "byField": "target",
                        "mode": "outerTabular"
                      }
                    },
                    {
                      "id": "organize",
                      "options": {
                        "excludeByName": {
                          "Time": true,
                          "Time 1": true,
                          "Time 2": true,
                          "Value #A": true
                        },
                        "indexByName": {
                          "target": 0,
                          "Value #B": 1,
                          "Value #C": 2
                        },
                        "renameByName": {
                          "target": "Target",
                          "Value #B": "Request",
                          "Value #C": "Limit"
                        }
                      }
                    }
                  ]
                },
                {
                  "id": 12,
                  "type": "timeseries",
                  "title": "Collector process CPU \u00b7 top 20",
                  "description": "CPU consumed by the Collector process. This is separate from container CPU usage and includes no container request or limit comparison. Shows up to 20 replicas.",
                  "gridPos": {
                    "x": 0,
                    "y": 63,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "(sum by (job, instance) (rate(otelcol_process_cpu_seconds_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval]))) and on (job, instance) topk(20, sum by (job, instance) (rate(otelcol_process_cpu_seconds_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval] @ end())))",
                      "legendFormat": "{{instance}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "cores",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 13,
                  "type": "timeseries",
                  "title": "Collector process RSS \u00b7 top 20",
                  "description": "Resident memory of each Collector process. RSS is not the memory limiter heap measurement. Shows up to 20 series with the highest value at the end of the selected range.",
                  "gridPos": {
                    "x": 12,
                    "y": 63,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "(max by (job, instance) (otelcol_process_memory_rss_bytes{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"})) and on (job, instance) topk(20, max by (job, instance) (otelcol_process_memory_rss_bytes{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"} @ end()))",
                      "legendFormat": "{{instance}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "bytes",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 15,
                  "type": "table",
                  "title": "Autoscaler conditions",
                  "description": "True Kubernetes HPA conditions. ScalingActive false or unknown means the HPA cannot currently calculate scaling. Check metrics-server and the HPA events. ScalingLimited can simply mean the configured replica limit was reached.",
                  "gridPos": {
                    "x": 0,
                    "y": 70,
                    "w": 24,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "max by (horizontalpodautoscaler, condition, status) (kube_horizontalpodautoscaler_status_condition{namespace=\"$namespace\",horizontalpodautoscaler=~\"nktp-.*\"} == 1)",
                      "legendFormat": "",
                      "refId": "A",
                      "range": false,
                      "instant": true,
                      "interval": "1m",
                      "format": "table"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "short",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ]
                    },
                    "overrides": []
                  },
                  "options": {
                    "showHeader": true,
                    "cellHeight": "sm",
                    "footer": {
                      "show": false
                    }
                  },
                  "transformations": [
                    {
                      "id": "organize",
                      "options": {
                        "excludeByName": {
                          "Time": true,
                          "Value": true
                        },
                        "renameByName": {
                          "horizontalpodautoscaler": "Autoscaler",
                          "condition": "Condition",
                          "status": "State"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": 46,
              "type": "row",
              "title": "KSM scrape size and growth",
              "collapsed": true,
              "gridPos": {
                "x": 0,
                "y": 35,
                "w": 24,
                "h": 1
              },
              "panels": [
                {
                  "id": 43,
                  "type": "timeseries",
                  "title": "KSM samples per scrape \u00b7 top 20",
                  "description": "Samples exposed by each KSM object endpoint. Selects the 20 largest peaks in the chosen range. This measures sample count, not response bytes or memory. Failed scrapes are gaps. Compare changes with scrape duration and the outlier table.",
                  "gridPos": {
                    "x": 0,
                    "y": 36,
                    "w": 12,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "(scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 1)) and on (job, instance) topk(20, max_over_time(scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}[$__range] @ end()))",
                      "legendFormat": "{{job}} \u00b7 {{pod}} \u00b7 {{instance}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "short",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "table",
                      "placement": "bottom",
                      "calcs": [
                        "max"
                      ],
                      "sortBy": "Max",
                      "sortDesc": true,
                      "height": 110
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 44,
                  "type": "timeseries",
                  "title": "Slowest KSM scrapes \u00b7 top 20",
                  "description": "Duration of KSM object scrape attempts, including failures. Selects the 20 slowest peaks in the selected range, preserving past outliers. The outlier table supplies current Up state. The telemetry endpoint is excluded.",
                  "gridPos": {
                    "x": 12,
                    "y": 36,
                    "w": 12,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "scrape_duration_seconds{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} and on (job, instance) topk(20, max_over_time(scrape_duration_seconds{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}[$__range] @ end()))",
                      "legendFormat": "{{job}} \u00b7 {{pod}} \u00b7 {{instance}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "s",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "table",
                      "placement": "bottom",
