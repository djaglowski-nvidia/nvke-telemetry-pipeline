          telemetry:
            logs:
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
            metrics:
              readers:
                - periodic:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
            resource:
              service.name: nktp-gateway-traces
            traces:
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
      env:
        - name: GOMEMLIMIT
          value: 896MiB
        - name: GOGC
          value: "50"
      image: otel/opentelemetry-collector-k8s:0.159.0
      managementState: managed
      mode: statefulset
      podDisruptionBudget:
        maxUnavailable: 25%
      podSecurityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      replicas: 2
      resources:
        limits:
          cpu: "1"
          memory: 1Gi
        requests:
          cpu: 200m
          memory: 512Mi
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop:
            - ALL
        readOnlyRootFilesystem: true
