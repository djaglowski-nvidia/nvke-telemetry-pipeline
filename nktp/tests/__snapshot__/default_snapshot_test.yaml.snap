              "datasource": {
                "type": "prometheus",
                "uid": "${metrics}"
              },
              "targets": [
                {
                  "expr": "sum by (job) ((sum by (job, instance, exporter) (rate(otelcol_exporter_send_failed_metric_points_total{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\"}[$__rate_interval])) or (0 * max by (job, instance, exporter) (otelcol_exporter_queue_capacity{job=~\"nktp-(daemonset|cluster-events|gateway-(logs|metrics|traces)|large-target-metrics|watchdog)\",data_type=\"metrics\"}))))",
                  "legendFormat": "{{job}} metrics",
                  "refId": "A",
