matches the snapshot with default values:
  1: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      name: nktp-cluster-events-NAMESPACE
    rules:
      - apiGroups:
          - ""
        resources:
          - events
        verbs:
          - get
          - list
          - watch
  2: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: nktp-cluster-events-NAMESPACE
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: nktp-cluster-events-NAMESPACE
    subjects:
      - kind: ServiceAccount
        name: nktp-cluster-events-collector
        namespace: NAMESPACE
  3: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      name: nktp-cluster-events
      namespace: NAMESPACE
    rules:
      - apiGroups:
          - coordination.k8s.io
        resourceNames:
          - nktp-cluster-events
        resources:
          - leases
        verbs:
          - get
          - update
  4: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      name: nktp-cluster-events
      namespace: NAMESPACE
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: nktp-cluster-events
    subjects:
      - kind: ServiceAccount
        name: nktp-cluster-events-collector
        namespace: NAMESPACE
  5: |
    apiVersion: coordination.k8s.io/v1
    kind: Lease
    metadata:
      name: nktp-cluster-events
      namespace: NAMESPACE
  6: |
    apiVersion: opentelemetry.io/v1beta1
    kind: OpenTelemetryCollector
    metadata:
      labels:
        helm.sh/chart: opentelemetry-kube-stack-0.22.0
      name: nktp-cluster-events
      namespace: NAMESPACE
    spec:
      config:
        exporters:
          otlp_http:
            endpoint: http://nktp-gateway-logs-collector:4318
            retry_on_failure:
              max_elapsed_time: 30m
            sending_queue:
              batch:
                flush_timeout: 1s
                max_size: 2097152
                min_size: 1048576
                sizer: bytes
              block_on_overflow: true
              num_consumers: 32
              queue_size: 16777216
              sizer: bytes
        extensions:
          health_check:
            endpoint: 0.0.0.0:13133
          k8s_leader_elector:
            auth_type: serviceAccount
            lease_name: nktp-cluster-events
            lease_namespace: ${env:POD_NAMESPACE}
        processors:
          memory_limiter:
            check_interval: 500ms
            limit_percentage: 80
            spike_limit_percentage: 25
        receivers:
          k8s_events:
            auth_type: serviceAccount
            k8s_leader_elector: k8s_leader_elector
            namespaces: []
        service:
          extensions:
            - health_check
            - k8s_leader_elector
          pipelines:
            logs:
              exporters:
                - otlp_http
              processors:
                - memory_limiter
              receivers:
                - k8s_events
          telemetry:
            logs:
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
            metrics:
              readers:
                - periodic:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
            resource:
              service.instance.id: ${env:POD_NAME}
              service.name: nktp-cluster-events
            traces:
              level: basic
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
      env:
        - name: GOMEMLIMIT
          value: 896MiB
        - name: GOGC
          value: "50"
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
      image: otel/opentelemetry-collector-k8s:0.159.0
      managementState: managed
      mode: statefulset
      podDisruptionBudget:
        maxUnavailable: 25%
      podSecurityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      replicas: 2
      resources:
        limits:
          cpu: "4"
          memory: 1Gi
        requests:
          cpu: "1"
          memory: 512Mi
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop:
            - ALL
        readOnlyRootFilesystem: true
      terminationGracePeriodSeconds: 60
      topologySpreadConstraints:
        - labelSelector:
            matchLabels:
              app.kubernetes.io/name: nktp-cluster-events-collector
          maxSkew: 1
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: ScheduleAnyway
        - labelSelector:
            matchLabels:
              app.kubernetes.io/name: nktp-cluster-events-collector
          maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
      upgradeStrategy: automatic
  7: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      name: nktp-daemonset-targetallocator-NAMESPACE
    rules:
      - apiGroups:
          - ""
        resources:
          - pods
          - services
          - endpoints
          - namespaces
          - nodes
        verbs:
          - get
          - list
          - watch
      - apiGroups:
          - discovery.k8s.io
        resources:
          - endpointslices
        verbs:
          - get
          - list
          - watch
      - apiGroups:
          - monitoring.coreos.com
        resources:
          - servicemonitors
          - podmonitors
          - probes
          - scrapeconfigs
        verbs:
          - get
          - list
          - watch
  8: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: nktp-daemonset-targetallocator-NAMESPACE
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: nktp-daemonset-targetallocator-NAMESPACE
    subjects:
      - kind: ServiceAccount
        name: nktp-daemonset-targetallocator
        namespace: NAMESPACE
  9: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      name: nktp-daemonset-kubelet-metrics-NAMESPACE
    rules:
      - apiGroups:
          - ""
        resources:
          - nodes/metrics
        verbs:
          - get
  10: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: nktp-daemonset-kubelet-metrics-binding-NAMESPACE
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: nktp-daemonset-kubelet-metrics-NAMESPACE
    subjects:
      - kind: ServiceAccount
        name: nktp-daemonset-collector
        namespace: NAMESPACE
  11: |
    apiVersion: opentelemetry.io/v1beta1
    kind: OpenTelemetryCollector
    metadata:
      labels:
        helm.sh/chart: opentelemetry-kube-stack-0.22.0
      name: nktp-daemonset
      namespace: NAMESPACE
    spec:
      config:
        exporters:
          otlp_http/logs:
            endpoint: http://nktp-gateway-logs-collector:4318
            retry_on_failure:
              max_elapsed_time: 30m
            sending_queue:
              batch:
                flush_timeout: 1s
                max_size: 2097152
                min_size: 1048576
                sizer: bytes
              block_on_overflow: true
              num_consumers: 32
              queue_size: 8388608
              sizer: bytes
          otlp_http/metrics:
            endpoint: http://nktp-gateway-metrics-collector:4318
            retry_on_failure:
              max_elapsed_time: 30m
            sending_queue:
              batch:
                flush_timeout: 1s
                max_size: 2097152
                min_size: 1048576
                sizer: bytes
              block_on_overflow: true
              num_consumers: 32
              queue_size: 33554432
              sizer: bytes
          otlp_http/traces:
            endpoint: http://nktp-gateway-traces-collector:4318
            retry_on_failure:
              max_elapsed_time: 30m
            sending_queue:
              batch:
                flush_timeout: 1s
                max_size: 2097152
                min_size: 1048576
                sizer: bytes
              block_on_overflow: true
              num_consumers: 32
              queue_size: 8388608
              sizer: bytes
          otlp_http/watchdog:
            endpoint: http://nktp-watchdog-collector:4318
            retry_on_failure:
              max_elapsed_time: 30m
            sending_queue:
              batch:
                flush_timeout: 1s
                max_size: 262144
                min_size: 65536
                sizer: bytes
              block_on_overflow: true
              num_consumers: 2
              queue_size: 1048576
              sizer: bytes
        extensions:
          health_check:
            endpoint: 0.0.0.0:13133
        processors:
          memory_limiter:
            check_interval: 500ms
            limit_percentage: 80
            spike_limit_percentage: 25
          resource/node:
            attributes:
              - action: upsert
                key: k8s.node.name
                value: ${env:NODE_NAME}
          transform/operator:
            log_statements:
              - context: resource
                statements:
                  - set(attributes["service.name"], "nktp-operator")
                  - set(attributes["service.instance.id"], attributes["k8s.pod.name"])
          transform/targetallocator:
            log_statements:
              - context: resource
                statements:
                  - set(attributes["service.instance.id"], attributes["k8s.pod.name"])
                  - set(attributes["service.name"], "nktp-targetallocator") where IsMatch(attributes["k8s.pod.name"], "^nktp-daemonset-targetallocator-")
                  - set(attributes["service.name"], "nktp-watchdog-targetallocator") where IsMatch(attributes["k8s.pod.name"], "^nktp-watchdog-targetallocator-")
                  - set(attributes["service.name"], "nktp-large-target-metrics-targetallocator") where IsMatch(attributes["k8s.pod.name"], "^nktp-large-target-metrics-targetallocator-")
        receivers:
          filelog:
            exclude:
              - /var/log/pods/${env:POD_NAMESPACE}_nktp-*-collector-*_*/*/*.log
              - /var/log/pods/${env:POD_NAMESPACE}_nktp-*-targetallocator-*_*/ta-container/*.log
              - /var/log/pods/${env:POD_NAMESPACE}_nktp-operator-*_*/manager/*.log
            include:
              - /var/log/pods/*/*/*.log
            include_file_path: true
            operators:
              - type: container
              - field: resource["nvidia.telemetry.class"]
                id: classify-control-plane
                if: resource["k8s.namespace.name"] == "kube-system" && ((resource["k8s.container.name"] == "kube-apiserver" && resource["k8s.pod.name"] matches "^kube-apiserver-") || (resource["k8s.container.name"] == "kube-controller-manager" && resource["k8s.pod.name"] matches "^kube-controller-manager-") || (resource["k8s.container.name"] == "kube-scheduler" && resource["k8s.pod.name"] matches "^kube-scheduler-") || (resource["k8s.container.name"] == "etcd" && resource["k8s.pod.name"] matches "^etcd-"))
                type: add
                value: k8s.control_plane
            retry_on_failure:
              enabled: true
              max_elapsed_time: 0
            start_at: end
          filelog/host-audit:
            include:
              - /hostfs/var/log/audit/audit.log
            include_file_path: true
            resource:
              nvidia.telemetry.class: system.audit
              service.name: auditd
            retry_on_failure:
              enabled: true
              max_elapsed_time: 0
            start_at: end
          filelog/host-auth:
            include:
              - /hostfs/var/log/auth.log
              - /hostfs/var/log/secure
            include_file_path: true
            resource:
              nvidia.telemetry.class: system.auth
              service.name: auth
            retry_on_failure:
              enabled: true
              max_elapsed_time: 0
            start_at: end
          filelog/kube-api-audit:
            include:
              - /hostfs/var/log/kubernetes/audit/audit.log
            include_file_path: true
            resource:
              nvidia.telemetry.class: k8s.api.audit
              service.name: kube-apiserver
            retry_on_failure:
              enabled: true
              max_elapsed_time: 0
            start_at: end
          filelog/operator:
            include:
              - /var/log/pods/${env:POD_NAMESPACE}_nktp-operator-*_*/manager/*.log
            include_file_path: true
            operators:
              - type: container
            retry_on_failure:
              enabled: true
              max_elapsed_time: 0
            start_at: beginning
          filelog/targetallocator:
            include:
              - /var/log/pods/${env:POD_NAMESPACE}_nktp-*-targetallocator-*_*/ta-container/*.log
            include_file_path: true
            operators:
              - type: container
            retry_on_failure:
              enabled: true
              max_elapsed_time: 0
            start_at: beginning
          hostmetrics:
            collection_interval: 1m
            root_path: /hostfs
            scrapers:
              process:
                resource_attributes:
                  process.command_line:
                    enabled: false
          journald:
            directory: /var/log/journal
            journalctl_path: /usr/bin/journalctl
            operators:
              - field: resource["service.name"]
                id: identify-journal-producer
                type: add
                value: journald
              - field: resource["nvidia.telemetry.class"]
                id: classify-host-auth
                if: body.SYSLOG_IDENTIFIER == "sshd" || body.SYSLOG_IDENTIFIER == "sudo"
                type: add
                value: system.auth
            priority: info
            retry_on_failure:
              enabled: true
              max_elapsed_time: 0
            root_path: /hostfs
            start_at: end
          otlp:
            protocols:
              grpc:
                endpoint: 0.0.0.0:4317
              http:
                endpoint: 0.0.0.0:4318
          prometheus:
            config:
              scrape_configs: []
          prometheus/kubelet:
            config:
              scrape_configs:
                - authorization:
                    credentials_file: /var/run/secrets/kubernetes.io/serviceaccount/token
                    type: Bearer
                  job_name: kubelet
                  metrics_path: /metrics
                  relabel_configs:
                    - regex: (.+:.*)
                      replacement: '[$$1]:10250'
                      source_labels:
                        - __tmp_kubelet_host
                      target_label: __address__
                    - regex: ([^:]+)
                      replacement: $$1:10250
                      source_labels:
                        - __tmp_kubelet_host
                      target_label: __address__
                    - replacement: ${env:NODE_NAME}
                      target_label: node
                    - replacement: https-metrics
                      target_label: endpoint
                    - replacement: /metrics
                      target_label: metrics_path
                  scheme: https
                  scrape_interval: 30s
                  scrape_timeout: 10s
                  static_configs:
                    - labels:
                        __tmp_kubelet_host: ${env:OTEL_K8S_NODE_IP}
                      targets:
                        - 127.0.0.1:10250
                  tls_config:
                    insecure_skip_verify: true
                - authorization:
                    credentials_file: /var/run/secrets/kubernetes.io/serviceaccount/token
                    type: Bearer
                  job_name: kubelet-cadvisor
                  metric_relabel_configs:
                    - action: drop
                      regex: container_cpu_(cfs_throttled_seconds_total|load_average_10s|system_seconds_total|user_seconds_total)
                      source_labels:
                        - __name__
                    - action: drop
                      regex: container_fs_(io_current|io_time_seconds_total|io_time_weighted_seconds_total|reads_merged_total|sector_reads_total|sector_writes_total|writes_merged_total)
                      source_labels:
                        - __name__
                    - action: drop
                      regex: container_memory_(mapped_file|swap)
                      source_labels:
                        - __name__
                    - action: drop
                      regex: container_(file_descriptors|tasks_state|threads_max)
                      source_labels:
                        - __name__
                    - action: drop
                      regex: container_memory_failures_total;hierarchy
                      source_labels:
                        - __name__
                        - scope
                    - action: drop
                      regex: container_network_.*;(cali|cilium|cni|lxc|nodelocaldns|tunl).*
                      source_labels:
                        - __name__
                        - interface
                    - action: drop
                      regex: container_spec.*
                      source_labels:
                        - __name__
                    - action: drop
                      regex: .+;
                      source_labels:
                        - id
                        - pod
                  metrics_path: /metrics/cadvisor
                  relabel_configs:
                    - regex: (.+:.*)
                      replacement: '[$$1]:10250'
                      source_labels:
                        - __tmp_kubelet_host
                      target_label: __address__
                    - regex: ([^:]+)
                      replacement: $$1:10250
                      source_labels:
                        - __tmp_kubelet_host
                      target_label: __address__
                    - replacement: ${env:NODE_NAME}
                      target_label: node
                    - replacement: https-metrics
                      target_label: endpoint
                    - replacement: /metrics/cadvisor
                      target_label: metrics_path
                  scheme: https
                  scrape_interval: 30s
                  scrape_timeout: 10s
                  static_configs:
                    - labels:
                        __tmp_kubelet_host: ${env:OTEL_K8S_NODE_IP}
                      targets:
                        - 127.0.0.1:10250
                  tls_config:
                    insecure_skip_verify: true
        service:
          extensions:
            - health_check
          pipelines:
            logs:
              exporters:
                - otlp_http/logs
              processors:
                - memory_limiter
                - resource/node
              receivers:
                - filelog
                - journald
                - otlp
                - filelog/host-auth
                - filelog/host-audit
                - filelog/kube-api-audit
            logs/operator:
              exporters:
                - otlp_http/watchdog
              processors:
                - memory_limiter
                - resource/node
                - transform/operator
              receivers:
                - filelog/operator
            logs/targetallocator:
              exporters:
                - otlp_http/watchdog
              processors:
                - memory_limiter
                - resource/node
                - transform/targetallocator
              receivers:
                - filelog/targetallocator
            metrics:
              exporters:
                - otlp_http/metrics
              processors:
                - memory_limiter
                - resource/node
              receivers:
                - prometheus
                - prometheus/kubelet
                - hostmetrics
                - otlp
            traces:
              exporters:
                - otlp_http/traces
              processors:
                - memory_limiter
                - resource/node
              receivers:
                - otlp
          telemetry:
            logs:
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
            metrics:
              readers:
                - periodic:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
            resource:
              k8s.node.name: ${env:NODE_NAME}
              service.instance.id: ${env:POD_NAME}
              service.name: nktp-daemonset
            traces:
              level: basic
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
      env:
        - name: GOMEMLIMIT
          value: 7GiB
        - name: GOGC
          value: "50"
        - name: NODE_NAME
          valueFrom:
            fieldRef:
              fieldPath: spec.nodeName
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: OTEL_K8S_NODE_IP
          valueFrom:
            fieldRef:
              fieldPath: status.hostIP
      image: otel/opentelemetry-collector-k8s:0.159.0
      managementState: managed
      mode: daemonset
      podSecurityContext:
        seccompProfile:
          type: RuntimeDefault
      resources:
        limits:
          cpu: "2"
          memory: 8Gi
        requests:
          cpu: "2"
          memory: 6Gi
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          add:
            - SYS_CHROOT
          drop:
            - ALL
        readOnlyRootFilesystem: true
        runAsUser: 0
      targetAllocator:
        allocationStrategy: per-node
        enabled: true
        env:
          - name: OTEL_SERVICE_NAME
            value: nktp-targetallocator
          - name: POD_NAME
            valueFrom:
              fieldRef:
                fieldPath: metadata.name
          - name: OTEL_RESOURCE_ATTRIBUTES
            value: service.instance.id=$(POD_NAME)
        observability:
          metrics:
            enableMetrics: false
        prometheusCR:
          denyFSAccessThroughSMs: true
          enabled: true
          podMonitorSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: NotIn
                values:
                  - "true"
          probeSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: NotIn
                values:
                  - "true"
          scrapeConfigSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: NotIn
                values:
                  - "true"
          serviceMonitorSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: NotIn
                values:
                  - "true"
              - key: app
                operator: NotIn
                values:
                  - kube-prometheus-stack-kubelet
                  - prometheus-operator-kubelet
        replicas: 1
        resources:
          limits:
            cpu: "2"
            memory: 4Gi
          requests:
            cpu: 250m
            memory: 2Gi
        telemetry:
          metrics:
            readers:
              - periodic:
                  exporter:
                    otlpHttp:
                      endpoint: http://nktp-watchdog-collector:4318
                      temporalityPreference: cumulative
                  interval: 30s
      terminationGracePeriodSeconds: 60
      tolerations:
        - operator: Exists
      upgradeStrategy: automatic
      volumeMounts:
        - mountPath: /var/log/pods
          name: pod-logs
          readOnly: true
        - mountPath: /hostfs/proc
          name: host-proc
          readOnly: true
        - mountPath: /hostfs/usr/bin/journalctl
          name: journalctl
          readOnly: true
        - mountPath: /hostfs/lib
          name: host-lib
          readOnly: true
        - mountPath: /hostfs/lib64
          name: host-lib64
          readOnly: true
        - mountPath: /hostfs/usr/lib64
          name: host-lib64
          readOnly: true
        - mountPath: /hostfs/usr/lib
          name: host-usr-lib
          readOnly: true
        - mountPath: /hostfs/etc/machine-id
          name: host-machine-id
          readOnly: true
        - mountPath: /hostfs/var/log
          name: host-logs
          readOnly: true
      volumes:
        - hostPath:
            path: /var/log/pods
            type: Directory
          name: pod-logs
        - hostPath:
            path: /proc
            type: Directory
          name: host-proc
        - hostPath:
            path: /usr/bin/journalctl
            type: File
          name: journalctl
        - hostPath:
            path: /lib
            type: Directory
          name: host-lib
        - hostPath:
            path: /lib64
            type: DirectoryOrCreate
          name: host-lib64
        - hostPath:
            path: /usr/lib
            type: Directory
          name: host-usr-lib
        - hostPath:
            path: /etc/machine-id
            type: File
          name: host-machine-id
        - hostPath:
            path: /var/log
            type: Directory
          name: host-logs
  12: |
    apiVersion: opentelemetry.io/v1beta1
    kind: OpenTelemetryCollector
    metadata:
      labels:
        helm.sh/chart: opentelemetry-kube-stack-0.22.0
      name: nktp-gateway-logs
      namespace: NAMESPACE
    spec:
      autoscaler:
        maxReplicas: 64
        minReplicas: 2
        targetCPUUtilization: 75
        targetMemoryUtilization: 100
      config:
        exporters:
          otlp_http:
            endpoint: http://lgtm:4318
            retry_on_failure:
              max_elapsed_time: 30m
            sending_queue:
              batch:
                flush_timeout: 1s
                max_size: 2097152
                min_size: 1048576
                sizer: bytes
              block_on_overflow: true
              num_consumers: 32
              queue_size: 16777216
              sizer: bytes
        extensions:
          health_check:
            endpoint: 0.0.0.0:13133
        processors:
          memory_limiter:
            check_interval: 500ms
            limit_percentage: 80
            spike_limit_percentage: 25
