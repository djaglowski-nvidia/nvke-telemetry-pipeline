                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "short",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ]
                    },
                    "overrides": [
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Target"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "string"
                          },
                          {
                            "id": "custom.width",
                            "value": 650
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Request"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "cores"
                          },
                          {
                            "id": "custom.width",
                            "value": 170
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Limit"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "cores"
                          },
                          {
                            "id": "custom.width",
                            "value": 170
                          }
                        ]
                      }
                    ]
                  },
                  "options": {
                    "showHeader": true,
                    "cellHeight": "sm",
                    "footer": {
                      "show": false
                    },
                    "sortBy": [
                      {
                        "displayName": "Request",
                        "desc": true
                      },
                      {
                        "displayName": "Limit",
                        "desc": true
                      },
                      {
                        "displayName": "Target",
                        "desc": false
                      }
                    ]
                  },
                  "transformations": [
                    {
                      "id": "joinByField",
                      "options": {
                        "byField": "target",
                        "mode": "outerTabular"
                      }
                    },
                    {
                      "id": "organize",
                      "options": {
                        "excludeByName": {
                          "Time": true,
                          "Time 1": true,
                          "Time 2": true,
                          "Value #A": true
                        },
                        "indexByName": {
                          "target": 0,
                          "Value #B": 1,
                          "Value #C": 2
                        },
                        "renameByName": {
                          "target": "Target",
                          "Value #B": "Request",
                          "Value #C": "Limit"
                        }
                      }
                    }
                  ]
                },
