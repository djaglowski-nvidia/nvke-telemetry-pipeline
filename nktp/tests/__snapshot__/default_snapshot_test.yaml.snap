  54: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      name: nktp-large-target-metrics-targetallocator-NAMESPACE
    rules:
      - apiGroups:
          - ""
        resources:
          - pods
          - services
          - endpoints
          - namespaces
          - nodes
        verbs:
          - get
          - list
          - watch
      - apiGroups:
          - discovery.k8s.io
        resources:
          - endpointslices
        verbs:
          - get
          - list
          - watch
      - apiGroups:
          - monitoring.coreos.com
        resources:
          - servicemonitors
          - podmonitors
          - probes
          - scrapeconfigs
        verbs:
          - get
          - list
          - watch
  55: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: nktp-large-target-metrics-targetallocator-NAMESPACE
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: nktp-large-target-metrics-targetallocator-NAMESPACE
    subjects:
      - kind: ServiceAccount
        name: nktp-large-target-metrics-targetallocator
        namespace: NAMESPACE
  56: |
    apiVersion: opentelemetry.io/v1beta1
    kind: OpenTelemetryCollector
    metadata:
      labels:
        helm.sh/chart: opentelemetry-kube-stack-0.22.0
      name: nktp-large-target-metrics
      namespace: NAMESPACE
    spec:
      autoscaler:
        maxReplicas: 16
        minReplicas: 2
        targetCPUUtilization: 75
        targetMemoryUtilization: 100
      config:
        exporters:
          otlp_http:
            endpoint: http://nktp-gateway-metrics-collector:4318
            retry_on_failure:
              max_elapsed_time: 30m
            sending_queue:
              batch:
                flush_timeout: 1s
                max_size: 2097152
                min_size: 1048576
                sizer: bytes
              block_on_overflow: true
              num_consumers: 32
              queue_size: 2147483648
              sizer: bytes
        extensions:
          health_check:
            endpoint: 0.0.0.0:13133
        processors:
          memory_limiter:
            check_interval: 500ms
            limit_percentage: 80
            spike_limit_percentage: 25
        receivers:
          prometheus:
            config:
              global:
                body_size_limit: 1GiB
                external_labels:
                  nktp_metrics_pool: large-target
                label_limit: 64
                label_name_length_limit: 256
                label_value_length_limit: 4096
                sample_limit: 1000000
              scrape_configs: []
        service:
          extensions:
            - health_check
          pipelines:
            metrics:
              exporters:
                - otlp_http
              processors:
                - memory_limiter
              receivers:
                - prometheus
          telemetry:
            logs:
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
            metrics:
              readers:
                - periodic:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
            resource:
              service.name: nktp-large-target-metrics
            traces:
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
      env:
        - name: GOMEMLIMIT
          value: 8GiB
        - name: GOGC
          value: "50"
      image: otel/opentelemetry-collector-k8s:0.159.0
      managementState: managed
      mode: statefulset
      podDisruptionBudget:
        maxUnavailable: 25%
      podSecurityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      replicas: 2
      resources:
        limits:
          cpu: "2"
          memory: 16Gi
        requests:
          cpu: 500m
          memory: 8Gi
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop:
            - ALL
        readOnlyRootFilesystem: true
      targetAllocator:
        allocationStrategy: consistent-hashing
        enabled: true
        observability:
          metrics:
            enableMetrics: false
        podSecurityContext:
          runAsNonRoot: true
          seccompProfile:
            type: RuntimeDefault
        prometheusCR:
          denyFSAccessThroughSMs: true
          enabled: true
          podMonitorSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: In
                values:
                  - "true"
          probeSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: In
                values:
                  - "true"
          scrapeConfigSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: In
                values:
                  - "true"
          serviceMonitorSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: In
                values:
                  - "true"
        replicas: 1
        resources:
          limits:
            cpu: "1"
            memory: 1Gi
          requests:
            cpu: 100m
            memory: 256Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
              - ALL
          readOnlyRootFilesystem: true
      terminationGracePeriodSeconds: 60
      topologySpreadConstraints:
        - labelSelector:
            matchLabels:
              app.kubernetes.io/name: nktp-large-target-metrics-collector
          maxSkew: 1
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: ScheduleAnyway
        - labelSelector:
            matchLabels:
              app.kubernetes.io/name: nktp-large-target-metrics-collector
          maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
      upgradeStrategy: automatic
  57: |
    apiVersion: v1
    data:
      nktp.yaml: |
        apiVersion: 1
        providers:
          - name: nktp
            type: file
            options:
              path: /otel-lgtm/dashboards-nktp
              foldersFromFilesStructure: false
      wipe-defaults.yaml: |
        apiVersion: 1
        providers: []
    kind: ConfigMap
    metadata:
      name: lgtm-dashboard-provider
  58: |
    apiVersion: v1
    data:
      nktp-cluster-events.json: |
        {
          "uid": "nktp-cluster-events",
          "title": "NKTP Cluster Events",
          "schemaVersion": 39,
          "refresh": "30s",
          "time": {
            "from": "now-30m",
            "to": "now"
          },
          "panels": [
            {
              "id": 1,
              "type": "stat",
              "title": "Reporting replicas",
              "description": "Collector processes with recent telemetry. This does not report Kubernetes readiness or identify the leader.",
              "gridPos": {
                "x": 0,
                "y": 0,
                "w": 24,
                "h": 4
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "decimals": 0,
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "count(count by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-cluster-events\"}))",
                  "instant": true,
                  "refId": "A"
                }
              ]
            },
            {
              "id": 2,
              "type": "timeseries",
              "title": "Received Event records",
              "gridPos": {
                "x": 0,
                "y": 4,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "decimals": 0,
                  "custom": {
                    "drawStyle": "bars",
                    "fillOpacity": 80,
                    "barAlignment": -1,
                    "stacking": {
                      "mode": "normal",
                      "group": "events"
                    }
                  }
                }
              },
              "targets": [
                {
                  "expr": "sum by (instance) (increase(otelcol_receiver_accepted_log_records_total{job=\"nktp-cluster-events\"}[$__interval]))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ],
              "description": "Records accepted during each interval, including updates to existing Kubernetes Events.",
              "interval": "2m"
            },
            {
              "id": 3,
              "type": "timeseries",
              "title": "Exported Event records",
              "gridPos": {
                "x": 12,
                "y": 4,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "decimals": 0,
                  "custom": {
                    "drawStyle": "bars",
                    "fillOpacity": 80,
                    "barAlignment": -1,
                    "stacking": {
                      "mode": "normal",
                      "group": "events"
                    }
                  }
                }
              },
              "targets": [
                {
                  "expr": "sum by (instance) (increase(otelcol_exporter_sent_log_records_total{job=\"nktp-cluster-events\"}[$__interval]))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ],
              "description": "Records exported to the configured backend during each interval.",
              "interval": "2m"
            },
            {
              "id": 4,
              "type": "timeseries",
              "title": "Export failures /s",
              "gridPos": {
                "x": 0,
                "y": 11,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum by (instance) (rate(otelcol_exporter_send_failed_log_records_total{job=\"nktp-cluster-events\"}[5m]))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 5,
              "type": "timeseries",
              "title": "Refused Event records /s",
              "gridPos": {
                "x": 12,
                "y": 11,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum by (instance) (rate(otelcol_receiver_refused_log_records_total{job=\"nktp-cluster-events\"}[5m]))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 6,
              "type": "timeseries",
              "title": "Exporter queue use",
              "gridPos": {
                "x": 0,
                "y": 18,
                "w": 24,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "min": 0,
                  "max": 100
                }
              },
              "targets": [
                {
                  "expr": "100 * sum by (instance, exporter) (otelcol_exporter_queue_size{job=\"nktp-cluster-events\",data_type=\"logs\"}) / sum by (instance, exporter) (otelcol_exporter_queue_capacity{job=\"nktp-cluster-events\",data_type=\"logs\"})",
                  "legendFormat": "{{instance}} / {{exporter}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 7,
              "type": "timeseries",
              "title": "CPU cores",
              "gridPos": {
                "x": 0,
                "y": 25,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "cores",
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum by (instance) (rate(otelcol_process_cpu_seconds_total{job=\"nktp-cluster-events\"}[5m]))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 8,
              "type": "timeseries",
              "title": "Memory (RSS)",
              "gridPos": {
                "x": 12,
                "y": 25,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "bytes",
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "max by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-cluster-events\"})",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 9,
              "type": "logs",
              "title": "Leadership changes",
              "description": "Receiver leadership transitions in the selected time range. The latest message is not a live Lease status check.",
              "gridPos": {
                "x": 0,
                "y": 32,
                "w": 24,
                "h": 8
              },
              "datasource": {
                "type": "loki",
                "uid": "loki"
              },
              "targets": [
                {
                  "expr": "{service_name=\"nktp-cluster-events\"} |~ \"Events Receiver started as leader|no longer leader, stopping\"",
                  "refId": "A"
                }
              ],
              "options": {
                "showTime": true,
                "showLabels": true,
                "wrapLogMessage": true,
                "sortOrder": "Descending",
                "enableLogDetails": true
              }
            }
          ]
        }
      nktp-daemonset.json: |
        {
          "uid": "nktp-daemonset",
          "title": "NKTP DaemonSet",
          "schemaVersion": 39,
          "refresh": "30s",
          "time": {
            "from": "now-30m",
            "to": "now"
          },
          "panels": [
            {
              "id": 1,
              "type": "timeseries",
              "title": "DaemonSet received /s",
              "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum by (k8s_node_name) (rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "{{k8s_node_name}} metric points",
                  "refId": "A"
                },
                {
                  "expr": "sum by (k8s_node_name) (rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "{{k8s_node_name}} log records",
                  "refId": "B"
                }
              ]
            },
            {
              "id": 2,
              "type": "timeseries",
              "title": "DaemonSet exported /s",
              "gridPos": {
                "x": 12,
                "y": 0,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum by (k8s_node_name) (rate(otelcol_exporter_sent_metric_points_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "{{k8s_node_name}} metric points",
                  "refId": "A"
                },
                {
                  "expr": "sum by (k8s_node_name) (rate(otelcol_exporter_sent_log_records_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "{{k8s_node_name}} log records",
                  "refId": "B"
                }
              ]
            },
            {
              "id": 3,
              "type": "timeseries",
              "title": "DaemonSet export failures /s",
              "gridPos": {
                "x": 0,
                "y": 7,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum by (k8s_node_name) (rate(otelcol_exporter_send_failed_metric_points_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "{{k8s_node_name}} metric points",
                  "refId": "A"
                },
                {
                  "expr": "sum by (k8s_node_name) (rate(otelcol_exporter_send_failed_log_records_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "{{k8s_node_name}} log records",
                  "refId": "B"
                }
              ]
            },
            {
              "id": 4,
              "type": "timeseries",
              "title": "DaemonSet refused /s",
              "gridPos": {
                "x": 12,
                "y": 7,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum by (k8s_node_name) (rate(otelcol_receiver_refused_metric_points_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "{{k8s_node_name}} metric points",
                  "refId": "A"
                },
                {
                  "expr": "sum by (k8s_node_name) (rate(otelcol_receiver_refused_log_records_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "{{k8s_node_name}} log records",
                  "refId": "B"
                }
              ]
            },
            {
              "id": 5,
              "type": "timeseries",
              "title": "DaemonSet exporter queue use",
              "gridPos": {
                "x": 0,
                "y": 14,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "percent"
                }
              },
              "targets": [
                {
                  "expr": "100 * max by (k8s_node_name, exporter, data_type) (otelcol_exporter_queue_size{job=\"nktp-daemonset\"} / otelcol_exporter_queue_capacity{job=\"nktp-daemonset\"})",
                  "legendFormat": "{{k8s_node_name}} {{exporter}} {{data_type}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 6,
              "type": "timeseries",
              "title": "DaemonSet reporting collectors",
              "gridPos": {
                "x": 12,
                "y": 14,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "count(count by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-daemonset\"}))",
                  "legendFormat": "reporting collectors",
                  "refId": "A"
                }
              ],
              "description": "Collectors with recent self metrics. This is not the desired DaemonSet pod count."
            },
            {
              "id": 7,
              "type": "timeseries",
              "title": "DaemonSet CPU cores",
              "gridPos": {
                "x": 0,
                "y": 21,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "cores"
                }
              },
              "targets": [
                {
                  "expr": "sum by (k8s_node_name) (rate(otelcol_process_cpu_seconds_total{job=\"nktp-daemonset\"}[5m]))",
                  "legendFormat": "{{k8s_node_name}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 8,
              "type": "timeseries",
              "title": "DaemonSet memory (RSS)",
              "gridPos": {
                "x": 12,
                "y": 21,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "bytes"
                }
              },
              "targets": [
                {
                  "expr": "sum by (k8s_node_name) (otelcol_process_memory_rss_bytes{job=\"nktp-daemonset\"})",
                  "legendFormat": "{{k8s_node_name}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 9,
              "type": "timeseries",
              "title": "Target Allocator scrape health",
              "gridPos": {
                "x": 0,
                "y": 28,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "up{job=\"nktp-targetallocator\"}",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ],
              "description": "One series per Target Allocator pod. Zero means its scrape failed. No data means no local Target Allocator pods were discovered or metrics collection is unavailable."
            },
            {
              "id": 10,
              "type": "timeseries",
              "title": "Target Allocator collectors",
              "gridPos": {
                "x": 12,
                "y": 28,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "opentelemetry_allocator_collectors_discovered{job=\"nktp-targetallocator\"}",
                  "legendFormat": "{{instance}} discovered",
                  "refId": "A"
                },
                {
                  "expr": "opentelemetry_allocator_collectors_allocatable{job=\"nktp-targetallocator\"}",
                  "legendFormat": "{{instance}} allocatable",
                  "refId": "B"
                }
              ]
            },
            {
              "id": 11,
              "type": "timeseries",
              "title": "Target Allocator targets",
              "gridPos": {
                "x": 0,
                "y": 35,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "opentelemetry_allocator_targets{job=\"nktp-targetallocator\"}",
                  "legendFormat": "{{instance}} discovered",
                  "refId": "A"
                },
                {
                  "expr": "opentelemetry_allocator_targets_remaining{job=\"nktp-targetallocator\"}",
                  "legendFormat": "{{instance}} after filtering",
                  "refId": "B"
                },
                {
                  "expr": "opentelemetry_allocator_targets_unassigned{job=\"nktp-targetallocator\"}",
                  "legendFormat": "{{instance}} unassigned",
                  "refId": "C"
                }
              ],
              "description": "Counts per Target Allocator replica. Replicas can report the same target set, so these counts are not summed."
            },
            {
              "id": 12,
              "type": "timeseries",
              "title": "Targets per collector",
              "gridPos": {
                "x": 12,
                "y": 35,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "opentelemetry_allocator_targets_per_collector{job=\"nktp-targetallocator\"}",
                  "legendFormat": "{{instance}} / {{collector_name}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 13,
              "type": "timeseries",
              "title": "Target Allocator CPU cores",
              "gridPos": {
                "x": 0,
                "y": 42,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "cores"
                }
              },
              "targets": [
                {
                  "expr": "rate(process_cpu_seconds_total{job=\"nktp-targetallocator\"}[5m])",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 14,
              "type": "timeseries",
              "title": "Target Allocator memory (RSS)",
              "gridPos": {
                "x": 12,
                "y": 42,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "bytes"
                }
              },
              "targets": [
                {
                  "expr": "process_resident_memory_bytes{job=\"nktp-targetallocator\"}",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            }
          ]
        }
      nktp-gateway-logs.json: |
        {
          "uid": "nktp-gateway-logs",
          "title": "NKTP Logs Gateway",
          "schemaVersion": 39,
          "refresh": "30s",
          "time": { "from": "now-30m", "to": "now" },
          "panels": [
            {
              "id": 1,
              "type": "timeseries",
              "title": "Received logs /s",
              "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "fieldConfig": { "defaults": { "min": 0 } },
              "targets": [
                { "expr": "sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-gateway-logs\"}[5m]))", "legendFormat": "log records", "refId": "A" }
              ]
            },
            {
              "id": 2,
              "type": "timeseries",
              "title": "Exported logs /s",
              "gridPos": { "x": 12, "y": 0, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "fieldConfig": { "defaults": { "min": 0 } },
              "targets": [
                { "expr": "sum(rate(otelcol_exporter_sent_log_records_total{job=\"nktp-gateway-logs\"}[5m]))", "legendFormat": "log records", "refId": "A" }
              ]
            },
            {
              "id": 3,
              "type": "timeseries",
              "title": "Export failures /s",
              "gridPos": { "x": 0, "y": 7, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "fieldConfig": { "defaults": { "min": 0 } },
              "targets": [
                { "expr": "sum(rate(otelcol_exporter_send_failed_log_records_total{job=\"nktp-gateway-logs\"}[5m]))", "legendFormat": "log records", "refId": "A" }
              ]
            },
            {
              "id": 4,
              "type": "timeseries",
              "title": "Refused logs /s",
              "gridPos": { "x": 12, "y": 7, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "fieldConfig": { "defaults": { "min": 0 } },
              "targets": [
                { "expr": "sum(rate(otelcol_receiver_refused_log_records_total{job=\"nktp-gateway-logs\"}[5m]))", "legendFormat": "log records", "refId": "A" }
              ]
            },
            {
              "id": 5,
              "type": "timeseries",
              "title": "Exporter queue use",
              "gridPos": { "x": 0, "y": 14, "w": 24, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
              "targets": [
                { "expr": "100 * sum by (exporter) (otelcol_exporter_queue_size{job=\"nktp-gateway-logs\",data_type=\"logs\"}) / sum by (exporter) (otelcol_exporter_queue_capacity{job=\"nktp-gateway-logs\",data_type=\"logs\"})", "legendFormat": "{{exporter}}", "refId": "A" }
              ]
            },
            {
              "id": 6,
              "type": "timeseries",
              "title": "CPU cores",
              "gridPos": { "x": 0, "y": 21, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "fieldConfig": { "defaults": { "unit": "cores", "min": 0 } },
              "targets": [
                { "expr": "sum(rate(otelcol_process_cpu_seconds_total{job=\"nktp-gateway-logs\"}[5m]))", "legendFormat": "CPU cores", "refId": "A" }
              ]
            },
            {
              "id": 7,
              "type": "timeseries",
              "title": "Memory (RSS)",
              "gridPos": { "x": 12, "y": 21, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 } },
              "targets": [
                { "expr": "sum(otelcol_process_memory_rss_bytes{job=\"nktp-gateway-logs\"})", "legendFormat": "RSS", "refId": "A" }
              ]
            }
          ]
        }
