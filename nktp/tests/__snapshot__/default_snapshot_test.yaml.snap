                {
                  "id": 45,
                  "type": "table",
                  "title": "KSM largest, growing and failed targets",
                  "description": "Up to 20 largest sample counts, 20 fastest-growing counts and 20 failed object endpoints. Sample-count growth estimates the change over the selected range from successful scrapes only. Gauge delta extrapolates across the range. Missing history stays Unknown. A failed scrape can report zero samples and does not establish a small target. Counts are not response bytes or memory.",
                  "gridPos": {
                    "x": 0,
                    "y": 44,
                    "w": 24,
                    "h": 9
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "max by (target) (label_join((scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}) and on (job, instance) (topk(20, scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}) or on (job, instance) topk(20, (delta((scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 1))[$__range:1m])) > 0) or on (job, instance) topk(20, up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 0)), \"target\", \" \u00b7 \", \"job\", \"pod\", \"instance\"))",
                      "instant": true,
                      "range": false,
                      "format": "table",
                      "refId": "A"
                    },
                    {
                      "expr": "max by (target) (label_join((delta((scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 1))[$__range:1m])) and on (job, instance) (topk(20, scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}) or on (job, instance) topk(20, (delta((scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 1))[$__range:1m])) > 0) or on (job, instance) topk(20, up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 0)), \"target\", \" \u00b7 \", \"job\", \"pod\", \"instance\"))",
                      "instant": true,
                      "range": false,
                      "format": "table",
                      "refId": "B"
                    },
                    {
                      "expr": "max by (target) (label_join((scrape_duration_seconds{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}) and on (job, instance) (topk(20, scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}) or on (job, instance) topk(20, (delta((scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 1))[$__range:1m])) > 0) or on (job, instance) topk(20, up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 0)), \"target\", \" \u00b7 \", \"job\", \"pod\", \"instance\"))",
                      "instant": true,
                      "range": false,
                      "format": "table",
                      "refId": "C"
                    },
                    {
                      "expr": "max by (target) (label_join((up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}) and on (job, instance) (topk(20, scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"}) or on (job, instance) topk(20, (delta((scrape_samples_scraped{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 1))[$__range:1m])) > 0) or on (job, instance) topk(20, up{job=~\"$namespace/nktp-ksm-.*\",endpoint=\"http-metrics\",namespace=\"$namespace\"} == 0)), \"target\", \" \u00b7 \", \"job\", \"pod\", \"instance\"))",
                      "instant": true,
                      "range": false,
                      "format": "table",
                      "refId": "D"
                    }
                  ],
                  "fieldConfig": {
