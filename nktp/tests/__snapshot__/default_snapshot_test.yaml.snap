matches the snapshot with default values:
  1: |
    apiVersion: opentelemetry.io/v1beta1
    kind: OpenTelemetryCollector
    metadata:
      labels:
        helm.sh/chart: opentelemetry-kube-stack-0.20.8
      name: nktp-gateway-logs
      namespace: NAMESPACE
    spec:
      autoscaler:
        maxReplicas: 64
        minReplicas: 2
        targetCPUUtilization: 75
        targetMemoryUtilization: 100
      config:
        exporters:
          otlp_http:
            endpoint: http://lgtm:4318
            retry_on_failure:
              max_elapsed_time: 30m
            sending_queue:
              batch:
                flush_timeout: 1s
                max_size: 2097152
                min_size: 1048576
                sizer: bytes
              num_consumers: 32
              queue_size: 16777216
              sizer: bytes
        extensions:
          health_check:
            endpoint: 0.0.0.0:13133
        processors:
          memory_limiter:
            check_interval: 500ms
            limit_percentage: 80
            spike_limit_percentage: 25
        receivers:
          otlp:
            protocols:
              grpc:
                endpoint: 0.0.0.0:4317
              http:
                endpoint: 0.0.0.0:4318
        service:
          extensions:
            - health_check
          pipelines:
            logs:
              exporters:
                - otlp_http
              processors:
                - memory_limiter
              receivers:
                - otlp
          telemetry:
            logs:
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
            metrics:
              readers:
                - periodic:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
            resource:
              service.name: nktp-gateway-logs
            traces:
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
      env:
        - name: GOMEMLIMIT
          value: 896MiB
        - name: GOGC
          value: "50"
      image: otel/opentelemetry-collector-k8s:0.159.0
      managementState: managed
      mode: statefulset
      podDisruptionBudget:
        maxUnavailable: 25%
      podSecurityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      replicas: 2
      resources:
        limits:
          cpu: "1"
          memory: 1Gi
        requests:
          cpu: 200m
          memory: 512Mi
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop:
            - ALL
        readOnlyRootFilesystem: true
      terminationGracePeriodSeconds: 60
      topologySpreadConstraints:
        - labelSelector:
            matchLabels:
              app.kubernetes.io/name: nktp-gateway-logs-collector
          maxSkew: 1
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: ScheduleAnyway
        - labelSelector:
            matchLabels:
              app.kubernetes.io/name: nktp-gateway-logs-collector
          maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
      upgradeStrategy: automatic
  2: |
    apiVersion: opentelemetry.io/v1beta1
    kind: OpenTelemetryCollector
    metadata:
      labels:
        helm.sh/chart: opentelemetry-kube-stack-0.20.8
