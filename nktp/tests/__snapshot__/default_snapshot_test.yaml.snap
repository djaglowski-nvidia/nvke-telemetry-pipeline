            {
              "id": 9,
              "type": "timeseries",
              "title": "Metrics flow",
              "description": "Metrics items per second at each Collector role. Each hop is shown separately. Do not sum the roles as unique traffic or interpret received minus sent as loss. Idle components can have no samples.",
              "gridPos": {
                "x": 0,
                "y": 25,
                "w": 8,
                "h": 8
              },
              "datasource": {
                "type": "prometheus",
