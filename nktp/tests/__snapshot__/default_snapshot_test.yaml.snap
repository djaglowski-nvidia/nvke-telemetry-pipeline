                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 49,
                  "type": "timeseries",
                  "title": "Mean allocation duration",
                  "description": "Elapsed seconds for each complete allocator SetTargets or SetCollectors call, including lock acquisition and allocation work. Replicas and methods remain separate. Idle methods have no mean. The pinned histogram buckets are too coarse for meaningful subsecond percentiles.",
                  "gridPos": {
                    "x": 0,
                    "y": 60,
                    "w": 24,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "sum by (job, instance, method, strategy) (rate(opentelemetry_allocator_time_to_allocate_sum{job=~\"nktp-(targetallocator|watchdog-targetallocator|large-target-metrics-targetallocator)\"}[$__rate_interval])) / (sum by (job, instance, method, strategy) (rate(opentelemetry_allocator_time_to_allocate_count{job=~\"nktp-(targetallocator|watchdog-targetallocator|large-target-metrics-targetallocator)\"}[$__rate_interval])) > 0)",
                      "refId": "A",
                      "instant": false,
                      "range": true,
                      "interval": "1m",
                      "legendFormat": "{{job}} \u00b7 {{instance}} \u00b7 {{method}}"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "s",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "table",
                      "placement": "bottom",
                      "calcs": [
                        "max"
                      ],
                      "sortBy": "Max",
                      "sortDesc": true,
                      "height": 110
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                }
              ]
            },
            {
              "id": 29,
              "type": "row",
              "title": "Operator and kube-state-metrics",
              "collapsed": true,
              "gridPos": {
                "x": 0,
                "y": 37,
                "w": 24,
                "h": 1
              },
              "panels": [
                {
                  "id": 23,
                  "type": "timeseries",
                  "title": "Operator reconciliation failures",
                  "description": "Operator reconciliation errors, panics and timeouts. Reconciliation retries can recover. Inspect Operator logs for the affected object.",
                  "gridPos": {
                    "x": 0,
                    "y": 38,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "sum by (controller) (rate(controller_runtime_reconcile_errors_total{job=\"nktp-operator\",namespace=\"$namespace\"}[$__rate_interval]))",
                      "legendFormat": "{{controller}} errors",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    },
                    {
                      "expr": "sum by (controller) (rate(controller_runtime_reconcile_panics_total{job=\"nktp-operator\",namespace=\"$namespace\"}[$__rate_interval]))",
                      "legendFormat": "{{controller}} panics",
                      "refId": "B",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    },
                    {
                      "expr": "sum by (controller) (rate(controller_runtime_reconcile_timeouts_total{job=\"nktp-operator\",namespace=\"$namespace\"}[$__rate_interval]))",
                      "legendFormat": "{{controller}} timeouts",
                      "refId": "C",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "ops",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 24,
                  "type": "timeseries",
                  "title": "Operator work queue",
                  "description": "Queued controller work. A sustained backlog together with errors or long reconcile times can delay Collector and Target Allocator changes.",
                  "gridPos": {
                    "x": 12,
                    "y": 38,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "max by (name) (workqueue_depth{job=\"nktp-operator\",namespace=\"$namespace\"})",
                      "legendFormat": "{{name}} queued",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "short",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 25,
                  "type": "timeseries",
                  "title": "Operator reconcile p95",
                  "description": "The 95th percentile of completed reconciliations. No value is expected when no reconciliations completed in the rate window.",
                  "gridPos": {
                    "x": 0,
                    "y": 45,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "histogram_quantile(0.95, sum by (le, controller) (rate(controller_runtime_reconcile_time_seconds_bucket{job=\"nktp-operator\",namespace=\"$namespace\"}[$__rate_interval])))",
                      "legendFormat": "{{controller}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "s",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 26,
                  "type": "timeseries",
                  "title": "KSM watch establishment errors",
                  "description": "Kubernetes watch establishment errors per KSM group. Zero is shown only when the corresponding watch counter exists. This does not count every error during an established watch.",
                  "gridPos": {
                    "x": 12,
                    "y": 45,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "(sum by (job) (rate(kube_state_metrics_watch_total{job=~\"$namespace/nktp-ksm-.*\",namespace=\"$namespace\",endpoint=\"telemetry\",result=\"error\"}[$__rate_interval]))) or (0 * sum by (job) (rate(kube_state_metrics_watch_total{job=~\"$namespace/nktp-ksm-.*\",namespace=\"$namespace\",endpoint=\"telemetry\"}[$__rate_interval])))",
                      "refId": "A",
                      "instant": false,
                      "range": true,
                      "interval": "1m",
                      "legendFormat": "{{job}} watch"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "ops",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 27,
                  "type": "timeseries",
                  "title": "Operator and KSM process CPU \u00b7 top 20",
                  "description": "Shows up to 20 processes with the highest value at the end of the selected range.",
                  "gridPos": {
                    "x": 0,
                    "y": 52,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "(max by (job, instance) (rate(process_cpu_seconds_total{job=~\"nktp-operator|$namespace/nktp-ksm-.*\",namespace=\"$namespace\"}[$__rate_interval]))) and on (job, instance) topk(20, max by (job, instance) (rate(process_cpu_seconds_total{job=~\"nktp-operator|$namespace/nktp-ksm-.*\",namespace=\"$namespace\"}[$__rate_interval] @ end())))",
                      "legendFormat": "{{job}} \u00b7 {{instance}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "cores",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 28,
                  "type": "timeseries",
                  "title": "Operator and KSM process RSS \u00b7 top 20",
                  "description": "Shows up to 20 processes with the highest value at the end of the selected range.",
                  "gridPos": {
                    "x": 12,
                    "y": 52,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "(max by (job, instance) (process_resident_memory_bytes{job=~\"nktp-operator|$namespace/nktp-ksm-.*\",namespace=\"$namespace\"})) and on (job, instance) topk(20, max by (job, instance) (process_resident_memory_bytes{job=~\"nktp-operator|$namespace/nktp-ksm-.*\",namespace=\"$namespace\"} @ end()))",
                      "legendFormat": "{{job}} \u00b7 {{instance}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "bytes",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 50,
                  "type": "table",
                  "title": "KSM central shard coverage",
                  "description": "Each resource group has its own shard set. Reporting counts distinct shard ordinals with a successful telemetry scrape, so duplicate replicas do not increase coverage. Configured comes from KSM total_shards. Missing is configured minus reporting. Missing telemetry stays Unknown; workload readiness remains the independent check when a whole group disappears.",
                  "gridPos": {
                    "x": 0,
                    "y": 59,
                    "w": 24,
                    "h": 9
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "label_replace((max by (job) (kube_state_metrics_total_shards{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"})), \"target\", \"$1\", \"job\", \"(.+)\")",
                      "refId": "A",
                      "instant": true,
                      "range": false,
                      "interval": "1m",
                      "legendFormat": "",
                      "format": "table"
                    },
                    {
                      "expr": "label_replace(((count by (job) (count by (job, shard_ordinal) (kube_state_metrics_shard_ordinal{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"} == 1)))) or (0 * (count by (job) (up{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"})))), \"target\", \"$1\", \"job\", \"(.+)\")",
                      "refId": "B",
                      "instant": true,
                      "range": false,
                      "interval": "1m",
                      "legendFormat": "",
                      "format": "table"
                    },
                    {
                      "expr": "label_replace((clamp_min((max by (job) (kube_state_metrics_total_shards{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"})) - ((count by (job) (count by (job, shard_ordinal) (kube_state_metrics_shard_ordinal{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"} == 1)))) or (0 * (count by (job) (up{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"})))), 0)), \"target\", \"$1\", \"job\", \"(.+)\")",
                      "refId": "C",
                      "instant": true,
                      "range": false,
                      "interval": "1m",
                      "legendFormat": "",
                      "format": "table"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "short",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ]
                    },
                    "overrides": [
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Target"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "string"
                          },
                          {
                            "id": "custom.width",
                            "value": 650
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Configured"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "short"
                          },
                          {
                            "id": "custom.width",
                            "value": 130
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Reporting"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "short"
                          },
                          {
                            "id": "custom.width",
                            "value": 130
                          }
                        ]
                      },
                      {
                        "matcher": {
                          "id": "byName",
                          "options": "Missing"
                        },
                        "properties": [
                          {
                            "id": "unit",
                            "value": "short"
                          },
                          {
                            "id": "custom.width",
                            "value": 130
                          }
                        ]
                      }
                    ]
                  },
                  "options": {
                    "showHeader": true,
                    "cellHeight": "sm",
                    "footer": {
                      "show": false
                    },
                    "sortBy": [
                      {
                        "displayName": "Target",
                        "desc": false
                      }
                    ]
                  },
                  "transformations": [
                    {
                      "id": "joinByField",
                      "options": {
                        "byField": "target",
                        "mode": "outerTabular"
                      }
                    },
                    {
                      "id": "organize",
                      "options": {
                        "excludeByName": {
                          "Time": true,
                          "Time 1": true,
                          "Time 2": true,
                          "job": true,
                          "job 1": true,
                          "job 2": true
                        },
                        "indexByName": {
                          "target": 0,
                          "Value #A": 1,
                          "Value #B": 2,
                          "Value #C": 3
                        },
                        "renameByName": {
                          "target": "Target",
                          "Value #A": "Configured",
                          "Value #B": "Reporting",
                          "Value #C": "Missing"
                        }
                      }
                    }
                  ]
                },
                {
                  "id": 51,
                  "type": "timeseries",
                  "title": "KSM node-local coverage",
                  "description": "Desired is the KSM pod DaemonSet desired node count. Reporting counts distinct nodes whose KSM telemetry endpoint scrapes successfully. These node-local instances all use shard ordinal 0 and are not one hash-sharded group. Successful telemetry scraping does not prove every Kubernetes object is current.",
                  "gridPos": {
                    "x": 0,
                    "y": 68,
                    "w": 24,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "max(kube_daemonset_status_desired_number_scheduled{namespace=\"$namespace\",daemonset=\"nktp-ksm-pods\"})",
                      "refId": "A",
                      "instant": false,
                      "range": true,
                      "interval": "1m",
                      "legendFormat": "Desired nodes"
                    },
                    {
                      "expr": "(count(count by (k8s_node_name) (up{job=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"} == 1))) or (0 * count(up{job=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"}))",
                      "refId": "B",
                      "instant": false,
                      "range": true,
                      "interval": "1m",
                      "legendFormat": "Nodes with successful KSM scrapes"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "short",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "table",
                      "placement": "bottom",
                      "calcs": [
                        "max"
                      ],
                      "sortBy": "Max",
                      "sortDesc": true,
                      "height": 110
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                }
              ]
            },
            {
              "id": 54,
              "type": "row",
              "title": "Node exporter diagnostics",
              "collapsed": true,
              "gridPos": {
                "x": 0,
                "y": 38,
                "w": 24,
                "h": 1
              },
              "panels": [
                {
                  "id": 52,
                  "type": "timeseries",
                  "title": "Node exporter collectors with no data or errors",
                  "description": "Number of instances whose node-exporter collector reports success=0 in its latest scrape. This includes both collection errors and unsupported or empty host data. It is not a cumulative error counter or a definitive node-health verdict.",
                  "gridPos": {
                    "x": 0,
                    "y": 39,
                    "w": 12,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "sum by (collector) (max by (instance, collector) (node_scrape_collector_success{job=\"node-exporter\",namespace=\"$namespace\"}) == bool 0)",
                      "refId": "A",
                      "instant": false,
                      "range": true,
                      "interval": "1m",
                      "legendFormat": "{{collector}}"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "short",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "table",
                      "placement": "bottom",
                      "calcs": [
                        "max"
                      ],
                      "sortBy": "Max",
                      "sortDesc": true,
                      "height": 110
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 53,
                  "type": "timeseries",
                  "title": "Slowest node exporter collectors",
                  "description": "Maximum latest collection duration across node-exporter instances for each collector. A gauge in seconds, including failed collection attempts.",
                  "gridPos": {
                    "x": 12,
                    "y": 39,
                    "w": 12,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "max by (collector) (node_scrape_collector_duration_seconds{job=\"node-exporter\",namespace=\"$namespace\"})",
                      "refId": "A",
                      "instant": false,
                      "range": true,
                      "interval": "1m",
                      "legendFormat": "{{collector}}"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "s",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "table",
                      "placement": "bottom",
                      "calcs": [
                        "max"
                      ],
                      "sortBy": "Max",
                      "sortDesc": true,
                      "height": 110
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                }
              ]
            },
            {
              "id": 34,
              "type": "row",
              "title": "Watchdog and bundled backend",
              "collapsed": true,
              "gridPos": {
                "x": 0,
                "y": 39,
                "w": 24,
                "h": 1
              },
              "panels": [
                {
                  "id": 30,
                  "type": "timeseries",
                  "title": "Diagnostic container logs collected",
                  "description": "Target Allocator and Operator stdout and stderr records accepted by the dedicated DaemonSet receivers. They are sent to watchdog. Collector internal logs use native OTLP export. Idle sources can have no records.",
                  "gridPos": {
                    "x": 0,
                    "y": 40,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "sum by (receiver) (rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-daemonset\",receiver=~\"filelog/(targetallocator|operator)\"}[$__rate_interval]))",
                      "legendFormat": "{{receiver}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "ops",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 31,
                  "type": "timeseries",
                  "title": "Watchdog pipeline queue use",
                  "description": "Watchdog pipeline exporter queue utilization. Watchdog internal telemetry is exported directly to the backend and does not pass through these pipeline queues.",
                  "gridPos": {
                    "x": 12,
                    "y": 40,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "100 * otelcol_exporter_queue_size{job=\"nktp-watchdog\"} / otelcol_exporter_queue_capacity{job=\"nktp-watchdog\"}",
                      "legendFormat": "{{instance}} \u00b7 {{data_type}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "percent",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 32,
                  "type": "timeseries",
                  "title": "Bundled backend ingest queue use",
                  "description": "Queues in the Collector inside the bundled LGTM container. This does not establish Loki, Tempo or Prometheus storage health. An external watchdog backend needs its own health monitoring.",
                  "gridPos": {
                    "x": 0,
                    "y": 47,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "100 * otelcol_exporter_queue_size{job=\"otelcol-contrib\"} / otelcol_exporter_queue_capacity{job=\"otelcol-contrib\"}",
                      "legendFormat": "{{exporter}} \u00b7 {{data_type}}",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "percent",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                },
                {
                  "id": 33,
                  "type": "timeseries",
                  "title": "Bundled backend failed sends",
                  "description": "Failed items sent from the bundled backend Collector to its storage services. Retries can recover. Zero is anchored to a present queue for that signal.",
                  "gridPos": {
                    "x": 12,
                    "y": 47,
                    "w": 12,
                    "h": 7
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "${metrics}"
                  },
                  "targets": [
                    {
                      "expr": "(sum(rate(otelcol_exporter_send_failed_metric_points_total{job=\"otelcol-contrib\"}[$__rate_interval])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"otelcol-contrib\",data_type=\"metrics\"}))",
                      "legendFormat": "metrics",
                      "refId": "A",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    },
                    {
                      "expr": "(sum(rate(otelcol_exporter_send_failed_log_records_total{job=\"otelcol-contrib\"}[$__rate_interval])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"otelcol-contrib\",data_type=\"logs\"}))",
                      "legendFormat": "logs",
                      "refId": "B",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    },
                    {
                      "expr": "(sum(rate(otelcol_exporter_send_failed_spans_total{job=\"otelcol-contrib\"}[$__rate_interval])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"otelcol-contrib\",data_type=\"traces\"}))",
                      "legendFormat": "traces",
                      "refId": "C",
                      "range": true,
                      "instant": false,
                      "interval": "1m"
                    }
                  ],
                  "fieldConfig": {
                    "defaults": {
                      "unit": "ops",
                      "min": 0,
                      "noValue": "Unknown",
                      "mappings": [
                        {
                          "type": "special",
                          "options": {
                            "match": "null",
                            "result": {
                              "text": "Unknown",
                              "color": "#8e8e8e"
                            }
                          }
                        }
                      ],
                      "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "fillOpacity": 8,
                        "showPoints": "never",
                        "spanNulls": false,
                        "axisBorderShow": false
                      }
                    },
                    "overrides": []
                  },
                  "transformations": [
                    {
                      "id": "renameByRegex",
                      "options": {
                        "regex": "^nktp-",
                        "renamePattern": ""
                      }
                    }
                  ],
                  "options": {
                    "legend": {
                      "displayMode": "list",
                      "placement": "bottom",
                      "calcs": []
                    },
                    "tooltip": {
                      "mode": "multi",
                      "sort": "desc"
                    }
                  }
                }
              ]
            },
            {
              "id": 37,
              "type": "row",
              "title": "Investigate logs and internal traces",
              "collapsed": true,
              "gridPos": {
                "x": 0,
                "y": 40,
                "w": 24,
                "h": 1
              },
              "panels": [
                {
                  "id": 35,
                  "type": "logs",
                  "title": "NKTP diagnostic logs",
                  "description": "Collector native logs and Target Allocator and Operator container logs delivered through watchdog. Pod identity is service_instance_id. Search is a case-insensitive text match and does not infer severity. Early plain-text startup errors remain searchable.",
                  "gridPos": {
                    "x": 0,
                    "y": 41,
                    "w": 24,
                    "h": 12
                  },
                  "datasource": {
                    "type": "loki",
                    "uid": "${logs}"
                  },
                  "targets": [
                    {
                      "refId": "A",
                      "expr": "{service_name=~\"$service\"} | label_format __nktp_search_match=`{{ contains (lower (urldecode \"${search:percentencode}\")) (lower (__line__)) }}` | __nktp_search_match=\"true\" | drop __nktp_search_match",
                      "queryType": "range",
                      "maxLines": 200
                    }
                  ],
                  "options": {
                    "showTime": true,
                    "showLabels": false,
                    "showCommonLabels": false,
                    "wrapLogMessage": false,
                    "prettifyLogMessage": false,
                    "enableLogDetails": true,
                    "sortOrder": "Descending",
                    "dedupStrategy": "none"
                  }
                },
                {
                  "id": 36,
                  "type": "table",
                  "title": "Collector internal traces",
                  "description": "Recent traces that contain a span from an NKTP Collector service. Collector instrumentation records its own receiver, processor and exporter work. Target Allocators and Operator do not emit native traces in the bundled version. Open a trace to inspect errors and latency.",
                  "gridPos": {
                    "x": 0,
                    "y": 53,
                    "w": 24,
                    "h": 9
                  },
                  "datasource": {
                    "type": "tempo",
                    "uid": "${traces}"
                  },
                  "targets": [
                    {
                      "refId": "A",
                      "queryType": "traceql",
                      "query": "{ resource.service.name =~ \"$service\" }",
                      "limit": 20,
                      "tableType": "traces"
                    }
                  ],
                  "options": {
                    "showHeader": true,
                    "cellHeight": "sm"
                  },
                  "fieldConfig": {
                    "defaults": {},
                    "overrides": []
                  }
                }
              ]
            }
          ]
        }
      nktp-large-target-metrics.json: |
        {
          "uid": "nktp-large-target-metrics",
          "title": "NKTP Large-target Metrics",
          "schemaVersion": 39,
          "refresh": "30s",
          "time": {
            "from": "now-30m",
            "to": "now"
          },
          "panels": [
            {
              "id": 1,
              "type": "timeseries",
              "title": "Received metrics /s",
              "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum by (instance) (rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-large-target-metrics\"}[5m]))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 2,
              "type": "timeseries",
              "title": "Exported metrics /s",
              "gridPos": {
                "x": 12,
                "y": 0,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum by (instance) (rate(otelcol_exporter_sent_metric_points_total{job=\"nktp-large-target-metrics\"}[5m]))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 3,
              "type": "timeseries",
              "title": "Export failures /s",
              "gridPos": {
                "x": 0,
                "y": 7,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum by (instance) (rate(otelcol_exporter_send_failed_metric_points_total{job=\"nktp-large-target-metrics\"}[5m]))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 4,
              "type": "timeseries",
              "title": "Refused metrics /s",
              "gridPos": {
                "x": 12,
                "y": 7,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum by (instance) (rate(otelcol_receiver_refused_metric_points_total{job=\"nktp-large-target-metrics\"}[5m]))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 5,
              "type": "timeseries",
              "title": "Exporter queue use",
              "gridPos": {
                "x": 0,
                "y": 14,
                "w": 24,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "min": 0,
                  "max": 100
                }
              },
              "targets": [
                {
                  "expr": "100 * sum by (instance, exporter) (otelcol_exporter_queue_size{job=\"nktp-large-target-metrics\",data_type=\"metrics\"}) / sum by (instance, exporter) (otelcol_exporter_queue_capacity{job=\"nktp-large-target-metrics\",data_type=\"metrics\"})",
                  "legendFormat": "{{instance}} {{exporter}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 6,
              "type": "timeseries",
              "title": "CPU cores",
              "gridPos": {
                "x": 0,
                "y": 21,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "cores",
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum by (instance) (rate(otelcol_process_cpu_seconds_total{job=\"nktp-large-target-metrics\"}[5m]))",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 7,
              "type": "timeseries",
              "title": "Memory (RSS)",
              "gridPos": {
                "x": 12,
                "y": 21,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "bytes",
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "sum by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-large-target-metrics\"})",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 8,
              "type": "histogram",
              "title": "Samples per scrape",
              "description": "Latest sample count per target before metric filtering. Sample count indicates scrape work. It does not measure response bytes or memory use.",
              "gridPos": {
                "x": 0,
                "y": 28,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "short"
                }
              },
              "options": {
                "combine": true,
                "bucketCount": 20
              },
              "targets": [
                {
                  "expr": "max by (job, instance) (scrape_samples_scraped{nktp_metrics_pool=\"large-target\",job!=\"nktp-large-target-metrics-targetallocator\"})",
                  "refId": "A",
                  "instant": true,
                  "range": false,
                  "format": "table"
                }
              ],
              "transformations": [
                {
                  "id": "filterFieldsByName",
                  "options": {
                    "include": {
                      "names": [
                        "Value"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "id": 10,
              "type": "timeseries",
              "title": "Target Allocator collectors",
              "gridPos": {
                "x": 0,
                "y": 35,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "opentelemetry_allocator_collectors_discovered{job=\"nktp-large-target-metrics-targetallocator\"}",
                  "legendFormat": "{{instance}} discovered",
                  "refId": "A"
                },
                {
                  "expr": "opentelemetry_allocator_collectors_allocatable{job=\"nktp-large-target-metrics-targetallocator\"}",
                  "legendFormat": "{{instance}} allocatable",
                  "refId": "B"
                }
              ]
            },
            {
              "id": 11,
              "type": "timeseries",
              "title": "Targets per collector",
              "gridPos": {
                "x": 12,
                "y": 35,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                }
              },
              "targets": [
                {
                  "expr": "opentelemetry_allocator_targets_per_collector{job=\"nktp-large-target-metrics-targetallocator\"}",
                  "legendFormat": "{{collector_name}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 12,
              "type": "timeseries",
              "title": "Target Allocator CPU cores",
              "gridPos": {
                "x": 0,
                "y": 42,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "cores"
                }
              },
              "targets": [
                {
                  "expr": "rate(process_cpu_seconds_total{job=\"nktp-large-target-metrics-targetallocator\"}[5m])",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 13,
              "type": "timeseries",
              "title": "Target Allocator memory (RSS)",
              "gridPos": {
                "x": 12,
                "y": 42,
                "w": 12,
                "h": 7
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "unit": "bytes"
                }
              },
              "targets": [
                {
                  "expr": "process_resident_memory_bytes{job=\"nktp-large-target-metrics-targetallocator\"}",
                  "legendFormat": "{{instance}}",
                  "refId": "A"
                }
              ]
            },
            {
              "id": 14,
              "type": "table",
              "title": "Largest targets by sample count",
              "description": "The 20 targets with the largest latest sample counts, with scrape duration matched by job and instance.",
              "gridPos": {
                "x": 0,
                "y": 49,
                "w": 24,
                "h": 8
              },
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Samples"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "short"
                      },
                      {
                        "id": "decimals",
                        "value": 0
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Scrape duration"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "s"
                      }
                    ]
                  }
                ]
              },
              "options": {
                "showHeader": true,
                "sortBy": [
                  {
                    "displayName": "Samples",
                    "desc": true
                  }
                ]
              },
              "targets": [
                {
                  "expr": "topk(20, max by (job, instance) (scrape_samples_scraped{nktp_metrics_pool=\"large-target\",job!=\"nktp-large-target-metrics-targetallocator\"}))",
                  "refId": "A",
                  "instant": true,
                  "range": false,
                  "format": "table"
                },
                {
                  "expr": "max by (job, instance) (scrape_duration_seconds{nktp_metrics_pool=\"large-target\",job!=\"nktp-large-target-metrics-targetallocator\"}) and on (job, instance) topk(20, max by (job, instance) (scrape_samples_scraped{nktp_metrics_pool=\"large-target\",job!=\"nktp-large-target-metrics-targetallocator\"}))",
                  "refId": "B",
                  "instant": true,
                  "range": false,
                  "format": "table"
                }
              ],
              "transformations": [
                {
                  "id": "merge",
                  "options": {}
                },
                {
                  "id": "organize",
                  "options": {
                    "excludeByName": {
                      "Time": true
                    },
                    "indexByName": {
                      "job": 0,
                      "instance": 1,
                      "Value #A": 2,
                      "Value #B": 3
                    },
                    "renameByName": {
                      "job": "Job",
                      "instance": "Instance",
                      "Value #A": "Samples",
                      "Value #B": "Scrape duration"
                    }
                  }
                }
              ]
            }
          ]
        }
      nktp-operator.json: |
        {
          "uid": "nktp-operator",
          "title": "NKTP Operator",
          "description": "OpenTelemetry Operator reconciliation, webhook HTTP traffic and process health. Requires scraped Operator metrics in the selected Prometheus datasource.",
          "tags": ["nktp", "opentelemetry"],
          "schemaVersion": 39,
          "refresh": "30s",
          "time": { "from": "now-30m", "to": "now" },
          "templating": {
            "list": [
              {
                "name": "datasource", "label": "Datasource", "type": "datasource", "query": "prometheus",
                "current": { "text": "prometheus", "value": "prometheus" }
              },
              {
                "name": "job", "label": "Scrape job", "type": "query",
                "datasource": { "type": "prometheus", "uid": "${datasource}" },
                "query": "label_values(controller_runtime_active_workers{controller=\"opentelemetrycollector\"}, job)",
                "refresh": 1, "multi": true, "includeAll": true,
                "current": { "text": "All", "value": "$__all" }
              }
            ]
          },
          "panels": [
            {
              "id": 1, "type": "stat", "title": "Reporting replicas",
              "description": "Operator processes with recent metrics for the selected scrape jobs. This is not the desired or Kubernetes Ready replica count.",
              "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 } },
              "targets": [{ "expr": "count(count by (instance) (process_start_time_seconds{job=~\"$job\"}))", "instant": true, "refId": "A" }]
            },
            {
              "id": 2, "type": "stat", "title": "Leaders",
              "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "targets": [{ "expr": "sum(leader_election_master_status{job=~\"$job\"})", "instant": true, "refId": "A" }]
            },
            {
              "id": 3, "type": "stat", "title": "Reconciliation errors /s",
              "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "targets": [{ "expr": "sum(rate(controller_runtime_reconcile_errors_total{job=~\"$job\"}[$__rate_interval]))", "instant": true, "refId": "A" }]
            },
            {
              "id": 4, "type": "stat", "title": "Webhook HTTP errors /s",
              "description": "HTTP 4xx and 5xx responses from the webhook server.",
              "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "targets": [{ "expr": "sum(rate(controller_runtime_webhook_requests_total{job=~\"$job\",code=~\"[45]..\"}[$__rate_interval])) or (0 * sum(rate(controller_runtime_webhook_requests_total{job=~\"$job\"}[$__rate_interval])))", "instant": true, "refId": "A" }]
            },
            {
              "id": 5, "type": "timeseries", "title": "Reconciliation events",
              "gridPos": { "x": 0, "y": 5, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "interval": "2m",
              "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "custom": { "drawStyle": "bars", "fillOpacity": 80, "barAlignment": -1, "stacking": { "mode": "normal", "group": "reconciliations" } } } },
              "targets": [{ "expr": "sum by (pod, controller, result) (increase(controller_runtime_reconcile_total{job=~\"$job\"}[$__interval]))", "legendFormat": "{{pod}} / {{controller}} / {{result}}", "refId": "A" }]
            },
            {
              "id": 6, "type": "timeseries", "title": "Reconciliation duration p95",
              "gridPos": { "x": 12, "y": 5, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
              "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, pod, controller) (rate(controller_runtime_reconcile_time_seconds_bucket{job=~\"$job\"}[$__rate_interval])))", "legendFormat": "{{pod}} / {{controller}}", "refId": "A" }]
            },
            {
              "id": 7, "type": "timeseries", "title": "Workqueue depth",
              "gridPos": { "x": 0, "y": 12, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "fieldConfig": { "defaults": { "min": 0 } },
              "targets": [{ "expr": "sum by (name, pod) (workqueue_depth{job=~\"$job\"})", "legendFormat": "{{name}} / {{pod}}", "refId": "A" }]
            },
            {
              "id": 8, "type": "timeseries", "title": "Reconciliation workers",
              "gridPos": { "x": 12, "y": 12, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "fieldConfig": { "defaults": { "min": 0 } },
              "targets": [
                { "expr": "controller_runtime_active_workers{job=~\"$job\"}", "legendFormat": "{{controller}} / {{pod}} active", "refId": "A" },
                { "expr": "controller_runtime_max_concurrent_reconciles{job=~\"$job\"}", "legendFormat": "{{controller}} / {{pod}} limit", "refId": "B" }
              ]
            },
            {
              "id": 9, "type": "timeseries", "title": "Webhook requests /s",
              "gridPos": { "x": 0, "y": 19, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "fieldConfig": { "defaults": { "min": 0 } },
              "targets": [{ "expr": "sum by (webhook, code) (rate(controller_runtime_webhook_requests_total{job=~\"$job\"}[$__rate_interval]))", "legendFormat": "{{webhook}} / HTTP {{code}}", "refId": "A" }]
            },
            {
              "id": 10, "type": "timeseries", "title": "Webhook duration p95",
              "gridPos": { "x": 12, "y": 19, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
              "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, pod, webhook) (rate(controller_runtime_webhook_latency_seconds_bucket{job=~\"$job\"}[$__rate_interval])))", "legendFormat": "{{pod}} / {{webhook}}", "refId": "A" }]
            },
            {
              "id": 11, "type": "timeseries", "title": "Operator CPU",
              "gridPos": { "x": 0, "y": 26, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "fieldConfig": { "defaults": { "unit": "cores", "min": 0 } },
              "targets": [{ "expr": "rate(process_cpu_seconds_total{job=~\"$job\"}[$__rate_interval])", "legendFormat": "{{pod}}", "refId": "A" }]
            },
            {
              "id": 12, "type": "timeseries", "title": "Operator memory (RSS)",
              "gridPos": { "x": 12, "y": 26, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 } },
              "targets": [{ "expr": "process_resident_memory_bytes{job=~\"$job\"}", "legendFormat": "{{pod}}", "refId": "A" }]
            }
          ]
        }
      nktp-watchdog.json: |
        {
          "uid": "nktp-watchdog",
          "title": "NKTP Watchdog",
          "schemaVersion": 39,
          "refresh": "30s",
          "time": { "from": "now-30m", "to": "now" },
          "panels": [
            {
              "id": 1,
              "type": "timeseries",
              "title": "Received /s",
              "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "fieldConfig": { "defaults": { "min": 0 } },
              "targets": [
                { "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-watchdog\"}[5m]))", "legendFormat": "metric points", "refId": "A" },
                { "expr": "sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-watchdog\"}[5m]))", "legendFormat": "log records", "refId": "B" },
                { "expr": "sum(rate(otelcol_receiver_accepted_spans_total{job=\"nktp-watchdog\"}[5m]))", "legendFormat": "spans", "refId": "C" }
              ]
            },
            {
              "id": 2,
              "type": "timeseries",
              "title": "Exported /s",
              "gridPos": { "x": 12, "y": 0, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "fieldConfig": { "defaults": { "min": 0 } },
              "targets": [
                { "expr": "sum(rate(otelcol_exporter_sent_metric_points_total{job=\"nktp-watchdog\"}[5m]))", "legendFormat": "metric points", "refId": "A" },
                { "expr": "sum(rate(otelcol_exporter_sent_log_records_total{job=\"nktp-watchdog\"}[5m]))", "legendFormat": "log records", "refId": "B" },
                { "expr": "sum(rate(otelcol_exporter_sent_spans_total{job=\"nktp-watchdog\"}[5m]))", "legendFormat": "spans", "refId": "C" }
              ]
            },
            {
              "id": 3,
              "type": "timeseries",
              "title": "Export failures /s",
              "gridPos": { "x": 0, "y": 7, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "fieldConfig": { "defaults": { "min": 0 } },
              "targets": [
                { "expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total{job=\"nktp-watchdog\"}[5m]))", "legendFormat": "metric points", "refId": "A" },
                { "expr": "sum(rate(otelcol_exporter_send_failed_log_records_total{job=\"nktp-watchdog\"}[5m]))", "legendFormat": "log records", "refId": "B" },
                { "expr": "sum(rate(otelcol_exporter_send_failed_spans_total{job=\"nktp-watchdog\"}[5m]))", "legendFormat": "spans", "refId": "C" }
              ]
            },
            {
              "id": 4,
              "type": "timeseries",
              "title": "Exporter queue use",
              "gridPos": { "x": 12, "y": 7, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
              "targets": [
                { "expr": "100 * sum by (exporter, data_type) (otelcol_exporter_queue_size{job=\"nktp-watchdog\"}) / sum by (exporter, data_type) (otelcol_exporter_queue_capacity{job=\"nktp-watchdog\"})", "legendFormat": "{{exporter}} {{data_type}}", "refId": "A" }
              ]
            },
            {
              "id": 5,
              "type": "timeseries",
              "title": "CPU cores",
              "gridPos": { "x": 0, "y": 14, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "fieldConfig": { "defaults": { "min": 0 } },
              "targets": [
                { "expr": "sum(rate(otelcol_process_cpu_seconds_total{job=\"nktp-watchdog\"}[5m]))", "legendFormat": "CPU cores", "refId": "A" }
              ]
            },
            {
              "id": 6,
              "type": "timeseries",
              "title": "Memory (RSS)",
              "gridPos": { "x": 12, "y": 14, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 } },
              "targets": [
                { "expr": "sum(otelcol_process_memory_rss_bytes{job=\"nktp-watchdog\"})", "legendFormat": "RSS", "refId": "A" }
              ]
            },
            {
              "id": 7, "type": "stat", "title": "Scrape targets up",
              "gridPos": { "x": 0, "y": 21, "w": 6, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "targets": [{ "expr": "sum(up{job=\"nktp-operator\"})", "legendFormat": "Operator", "instant": true, "refId": "A" }]
            },
            {
              "id": 8, "type": "timeseries", "title": "Allocator collectors",
              "gridPos": { "x": 6, "y": 21, "w": 9, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "fieldConfig": { "defaults": { "min": 0 } },
              "targets": [
                { "expr": "sum(opentelemetry_allocator_collectors_discovered{job=\"nktp-watchdog-targetallocator\"})", "legendFormat": "discovered", "refId": "A" },
                { "expr": "sum(opentelemetry_allocator_collectors_allocatable{job=\"nktp-watchdog-targetallocator\"})", "legendFormat": "allocatable", "refId": "B" }
              ]
            },
            {
              "id": 9, "type": "timeseries", "title": "Targets per collector",
              "gridPos": { "x": 15, "y": 21, "w": 9, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "fieldConfig": { "defaults": { "min": 0 } },
              "targets": [{ "expr": "opentelemetry_allocator_targets_per_collector{job=\"nktp-watchdog-targetallocator\"}", "legendFormat": "{{collector_name}}", "refId": "A" }]
            }
          ]
        }
      otel-lgtm-health.json: |
        {
          "uid": "otel-lgtm-health",
          "title": "OTel LGTM Health",
          "schemaVersion": 39,
          "refresh": "30s",
          "time": { "from": "now-30m", "to": "now" },
          "panels": [
            {
              "type": "stat",
              "title": "Internal collector up",
              "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "targets": [{ "expr": "sum(up{job=\"otelcol-contrib\"})", "refId": "A" }]
            },
            {
              "type": "timeseries",
              "title": "Received /s",
              "gridPos": { "x": 6, "y": 0, "w": 9, "h": 6 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "targets": [
                { "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total[5m]))", "legendFormat": "metric points", "refId": "A" },
                { "expr": "sum(rate(otelcol_receiver_accepted_log_records_total[5m]))", "legendFormat": "log records", "refId": "B" },
                { "expr": "sum(rate(otelcol_receiver_accepted_spans_total[5m]))", "legendFormat": "spans", "refId": "C" }
              ]
            },
            {
              "type": "timeseries",
              "title": "Exported /s",
              "gridPos": { "x": 15, "y": 0, "w": 9, "h": 6 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "targets": [
                { "expr": "sum(rate(otelcol_exporter_sent_metric_points_total[5m]))", "legendFormat": "metric points", "refId": "A" },
                { "expr": "sum(rate(otelcol_exporter_sent_log_records_total[5m]))", "legendFormat": "log records", "refId": "B" },
                { "expr": "sum(rate(otelcol_exporter_sent_spans_total[5m]))", "legendFormat": "spans", "refId": "C" }
              ]
            },
            {
              "type": "timeseries",
              "title": "Collector memory (RSS)",
              "gridPos": { "x": 0, "y": 6, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "fieldConfig": { "defaults": { "unit": "bytes" } },
              "targets": [{ "expr": "otelcol_process_memory_rss", "legendFormat": "{{job}}", "refId": "A" }]
            },
            {
              "type": "timeseries",
              "title": "Exporter queue size",
              "gridPos": { "x": 12, "y": 6, "w": 12, "h": 7 },
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "options": { "tooltip": { "mode": "multi" } },
              "targets": [
                { "expr": "otelcol_exporter_queue_size", "legendFormat": "{{data_type}} size", "refId": "A" },
                { "expr": "otelcol_exporter_queue_capacity", "legendFormat": "{{data_type}} capacity", "refId": "B" }
              ]
            }
          ]
        }
    kind: ConfigMap
    metadata:
      name: lgtm-dashboards
  61: |
    apiVersion: v1
    kind: Service
    metadata:
      name: lgtm
    spec:
      ports:
        - name: prometheus
          port: 9090
          protocol: TCP
          targetPort: 9090
        - name: grafana
          port: 3000
          protocol: TCP
          targetPort: 3000
        - name: otel-grpc
          port: 4317
          protocol: TCP
          targetPort: 4317
        - name: otel-http
          port: 4318
          protocol: TCP
          targetPort: 4318
      selector:
        app: lgtm
  62: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      name: lgtm
    spec:
      replicas: 1
      selector:
        matchLabels:
          app: lgtm
      template:
        metadata:
          annotations:
            checksum/dashboards: 189b5b505296e5106cfb27cea93677a52b268095d3ccb9f53c3368dce23871b8
          labels:
            app: lgtm
        spec:
          containers:
            - env:
                - name: GF_AUTH_ANONYMOUS_ENABLED
                  value: "true"
                - name: GF_AUTH_ANONYMOUS_ORG_ROLE
                  value: Admin
                - name: PROMETHEUS_EXTRA_ARGS
                  value: --enable-feature=otlp-deltatocumulative
              image: grafana/otel-lgtm:0.32.0
              name: lgtm
              ports:
                - containerPort: 3000
                - containerPort: 4317
                - containerPort: 4318
              readinessProbe:
                exec:
                  command:
                    - cat
                    - /tmp/ready
              volumeMounts:
                - mountPath: /otel-lgtm/grafana/conf/provisioning/dashboards/nktp.yaml
                  name: dashboard-provider
                  subPath: nktp.yaml
                - mountPath: /otel-lgtm/grafana/conf/provisioning/dashboards/grafana-dashboards.yaml
                  name: dashboard-provider
                  subPath: wipe-defaults.yaml
                - mountPath: /otel-lgtm/dashboards-nktp
                  name: dashboards
                - mountPath: /data/tempo
                  name: tempo-data
                - mountPath: /data/grafana
                  name: grafana-data
                - mountPath: /data/loki
                  name: loki-data
                - mountPath: /loki
                  name: loki-storage
                - mountPath: /data/prometheus
                  name: p8s-storage
                - mountPath: /data/pyroscope
                  name: pyroscope-storage
          volumes:
            - configMap:
                name: lgtm-dashboard-provider
              name: dashboard-provider
            - configMap:
                name: lgtm-dashboards
              name: dashboards
            - emptyDir: {}
              name: tempo-data
            - emptyDir: {}
              name: loki-data
            - emptyDir: {}
              name: grafana-data
            - emptyDir: {}
              name: loki-storage
            - emptyDir: {}
              name: p8s-storage
            - emptyDir: {}
              name: pyroscope-storage
  63: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: nktp-watchdog-operator-metrics-NAMESPACE
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: nktp-operator-metrics
    subjects:
      - kind: ServiceAccount
        name: nktp-watchdog-collector
        namespace: NAMESPACE
  64: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      name: nktp-watchdog-targetallocator
      namespace: NAMESPACE
    rules:
      - apiGroups:
          - ""
        resources:
          - pods
          - services
        verbs:
          - get
          - list
          - watch
      - apiGroups:
          - discovery.k8s.io
        resources:
          - endpointslices
        verbs:
          - get
          - list
          - watch
  65: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      name: nktp-watchdog-targetallocator
      namespace: NAMESPACE
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: nktp-watchdog-targetallocator
    subjects:
      - kind: ServiceAccount
        name: nktp-watchdog-targetallocator
        namespace: NAMESPACE
  66: |
    apiVersion: opentelemetry.io/v1beta1
    kind: OpenTelemetryCollector
    metadata:
      labels:
        helm.sh/chart: opentelemetry-kube-stack-0.22.0
      name: nktp-watchdog
      namespace: NAMESPACE
    spec:
      autoscaler:
        maxReplicas: 16
        minReplicas: 2
        targetCPUUtilization: 75
        targetMemoryUtilization: 100
      config:
        exporters:
          otlp_http:
            endpoint: http://lgtm:4318
            retry_on_failure:
              max_elapsed_time: 30m
            sending_queue:
              batch:
                flush_timeout: 1s
                max_size: 2097152
                min_size: 1048576
                sizer: bytes
              block_on_overflow: true
              num_consumers: 32
              queue_size: 8388608
              sizer: bytes
        extensions:
          health_check:
            endpoint: 0.0.0.0:13133
        processors:
          memory_limiter:
            check_interval: 500ms
            limit_percentage: 80
            spike_limit_percentage: 25
        receivers:
          otlp:
            protocols:
              http:
                endpoint: 0.0.0.0:4318
          prometheus:
            config:
              scrape_configs:
                - bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
                  job_name: nktp-operator
                  kubernetes_sd_configs:
                    - namespaces:
                        own_namespace: true
                      role: endpointslice
                  relabel_configs:
                    - action: keep
                      regex: nktp-operator;metrics;true;Pod
                      source_labels:
                        - __meta_kubernetes_service_name
                        - __meta_kubernetes_endpointslice_port_name
                        - __meta_kubernetes_endpointslice_endpoint_conditions_ready
                        - __meta_kubernetes_endpointslice_address_target_kind
                    - source_labels:
                        - __meta_kubernetes_namespace
                      target_label: namespace
                    - source_labels:
                        - __meta_kubernetes_endpointslice_address_target_name
                      target_label: pod
                  scheme: https
                  scrape_interval: 30s
                  tls_config:
                    insecure_skip_verify: true
        service:
          extensions:
            - health_check
          pipelines:
            logs:
              exporters:
                - otlp_http
              processors:
                - memory_limiter
              receivers:
                - otlp
            metrics:
              exporters:
                - otlp_http
              processors:
                - memory_limiter
              receivers:
                - otlp
                - prometheus
            traces:
              exporters:
                - otlp_http
              processors:
                - memory_limiter
              receivers:
                - otlp
          telemetry:
            logs:
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://lgtm:4318
                        protocol: http/protobuf
            metrics:
              readers:
                - periodic:
                    exporter:
                      otlp:
                        endpoint: http://lgtm:4318
                        protocol: http/protobuf
            resource:
              service.instance.id: ${env:POD_NAME}
              service.name: nktp-watchdog
            traces:
              level: basic
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://lgtm:4318
                        protocol: http/protobuf
      env:
        - name: GOMEMLIMIT
          value: 448MiB
        - name: GOGC
          value: "50"
      image: otel/opentelemetry-collector-k8s:0.159.0
      managementState: managed
      mode: statefulset
      podDisruptionBudget:
        maxUnavailable: 25%
      podSecurityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      replicas: 2
      resources:
        limits:
          cpu: 500m
          memory: 512Mi
        requests:
          cpu: 100m
          memory: 256Mi
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop:
            - ALL
        readOnlyRootFilesystem: true
      targetAllocator:
        allocationStrategy: consistent-hashing
        enabled: true
        env:
          - name: OTEL_SERVICE_NAME
            value: nktp-watchdog-targetallocator
          - name: POD_NAME
            valueFrom:
              fieldRef:
                fieldPath: metadata.name
          - name: OTEL_RESOURCE_ATTRIBUTES
            value: service.instance.id=$(POD_NAME)
        observability:
          metrics:
            enableMetrics: false
        prometheusCR:
          enabled: false
        replicas: 1
        resources:
          limits:
            cpu: "1"
            memory: 2Gi
          requests:
            cpu: 250m
            memory: 1Gi
        telemetry:
          metrics:
            readers:
              - periodic:
                  exporter:
                    otlpHttp:
                      endpoint: http://nktp-watchdog-collector:4318
                      temporalityPreference: cumulative
                  interval: 30s
      terminationGracePeriodSeconds: 60
      topologySpreadConstraints:
        - labelSelector:
            matchLabels:
              app.kubernetes.io/name: nktp-watchdog-collector
          maxSkew: 1
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: ScheduleAnyway
        - labelSelector:
            matchLabels:
              app.kubernetes.io/name: nktp-watchdog-collector
          maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
      upgradeStrategy: automatic
