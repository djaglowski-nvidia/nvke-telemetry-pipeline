matches the snapshot with default values:
  1: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      name: nktp-cluster-events-NAMESPACE
    rules:
      - apiGroups:
          - ""
        resources:
          - events
        verbs:
          - get
          - list
          - watch
  2: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: nktp-cluster-events-NAMESPACE
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: nktp-cluster-events-NAMESPACE
    subjects:
      - kind: ServiceAccount
        name: nktp-cluster-events-collector
        namespace: NAMESPACE
  3: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      name: nktp-cluster-events
      namespace: NAMESPACE
    rules:
      - apiGroups:
          - coordination.k8s.io
        resourceNames:
          - nktp-cluster-events
        resources:
          - leases
        verbs:
          - get
          - update
  4: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      name: nktp-cluster-events
      namespace: NAMESPACE
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: nktp-cluster-events
    subjects:
      - kind: ServiceAccount
        name: nktp-cluster-events-collector
        namespace: NAMESPACE
  5: |
    apiVersion: coordination.k8s.io/v1
    kind: Lease
    metadata:
      name: nktp-cluster-events
      namespace: NAMESPACE
  6: |
    apiVersion: opentelemetry.io/v1beta1
    kind: OpenTelemetryCollector
    metadata:
      labels:
        helm.sh/chart: opentelemetry-kube-stack-0.22.0
      name: nktp-cluster-events
      namespace: NAMESPACE
    spec:
      config:
        exporters:
          otlp_http:
            endpoint: http://nktp-gateway-logs-collector:4318
            retry_on_failure:
              max_elapsed_time: 30m
            sending_queue:
              batch:
                flush_timeout: 1s
                max_size: 2097152
                min_size: 1048576
                sizer: bytes
              block_on_overflow: true
              num_consumers: 32
              queue_size: 16777216
              sizer: bytes
        extensions:
          health_check:
            endpoint: 0.0.0.0:13133
          k8s_leader_elector:
            auth_type: serviceAccount
            lease_name: nktp-cluster-events
            lease_namespace: ${env:POD_NAMESPACE}
        processors:
          memory_limiter:
            check_interval: 500ms
            limit_percentage: 80
            spike_limit_percentage: 25
        receivers:
          k8s_events:
            auth_type: serviceAccount
            k8s_leader_elector: k8s_leader_elector
            namespaces: []
        service:
          extensions:
            - health_check
            - k8s_leader_elector
          pipelines:
            logs:
              exporters:
                - otlp_http
              processors:
                - memory_limiter
              receivers:
                - k8s_events
          telemetry:
            logs:
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
            metrics:
              readers:
                - periodic:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
            resource:
              service.name: nktp-cluster-events
            traces:
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
      env:
        - name: GOMEMLIMIT
          value: 896MiB
        - name: GOGC
          value: "50"
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
      image: otel/opentelemetry-collector-k8s:0.159.0
      managementState: managed
      mode: statefulset
      podDisruptionBudget:
        maxUnavailable: 25%
      podSecurityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      replicas: 2
      resources:
        limits:
          cpu: "1"
          memory: 1Gi
        requests:
          cpu: 200m
          memory: 512Mi
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop:
            - ALL
        readOnlyRootFilesystem: true
      terminationGracePeriodSeconds: 60
      topologySpreadConstraints:
        - labelSelector:
            matchLabels:
              app.kubernetes.io/name: nktp-cluster-events-collector
          maxSkew: 1
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: ScheduleAnyway
        - labelSelector:
            matchLabels:
              app.kubernetes.io/name: nktp-cluster-events-collector
          maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
      upgradeStrategy: automatic
  7: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      name: nktp-daemonset-targetallocator-NAMESPACE
    rules:
      - apiGroups:
          - ""
        resources:
          - pods
          - services
          - endpoints
          - namespaces
          - nodes
        verbs:
          - get
          - list
          - watch
      - apiGroups:
          - discovery.k8s.io
        resources:
          - endpointslices
        verbs:
          - get
          - list
          - watch
      - apiGroups:
          - monitoring.coreos.com
        resources:
          - servicemonitors
          - podmonitors
          - probes
          - scrapeconfigs
        verbs:
          - get
          - list
          - watch
  8: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: nktp-daemonset-targetallocator-NAMESPACE
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: nktp-daemonset-targetallocator-NAMESPACE
    subjects:
      - kind: ServiceAccount
        name: nktp-daemonset-targetallocator
        namespace: NAMESPACE
  9: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      name: nktp-daemonset-targetallocator-metrics
      namespace: NAMESPACE
    rules:
      - apiGroups:
          - ""
        resources:
          - pods
        verbs:
          - get
          - list
          - watch
  10: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      name: nktp-daemonset-targetallocator-metrics
      namespace: NAMESPACE
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: nktp-daemonset-targetallocator-metrics
    subjects:
      - kind: ServiceAccount
        name: nktp-daemonset-collector
        namespace: NAMESPACE
  11: |
    apiVersion: opentelemetry.io/v1beta1
    kind: OpenTelemetryCollector
    metadata:
      labels:
        helm.sh/chart: opentelemetry-kube-stack-0.22.0
      name: nktp-daemonset
      namespace: NAMESPACE
    spec:
      config:
        exporters:
          otlp_http/logs:
            endpoint: http://nktp-gateway-logs-collector:4318
            retry_on_failure:
              max_elapsed_time: 30m
            sending_queue:
              batch:
                flush_timeout: 1s
                max_size: 2097152
                min_size: 1048576
                sizer: bytes
              block_on_overflow: true
              num_consumers: 32
              queue_size: 8388608
              sizer: bytes
          otlp_http/metrics:
            endpoint: http://nktp-gateway-metrics-collector:4318
            retry_on_failure:
              max_elapsed_time: 30m
            sending_queue:
              batch:
                flush_timeout: 1s
                max_size: 2097152
                min_size: 1048576
                sizer: bytes
              block_on_overflow: true
              num_consumers: 32
              queue_size: 8388608
              sizer: bytes
          otlp_http/watchdog:
            endpoint: http://nktp-watchdog-collector:4318
            retry_on_failure:
              max_elapsed_time: 30m
            sending_queue:
              batch:
                flush_timeout: 1s
                max_size: 262144
                min_size: 65536
                sizer: bytes
              block_on_overflow: true
              num_consumers: 2
              queue_size: 1048576
              sizer: bytes
        extensions:
          health_check:
            endpoint: 0.0.0.0:13133
        processors:
          memory_limiter:
            check_interval: 500ms
            limit_percentage: 80
            spike_limit_percentage: 25
          memory_limiter/targetallocator:
            check_interval: 500ms
            limit_percentage: 80
            spike_limit_percentage: 25
          resource/node:
            attributes:
              - action: upsert
                key: k8s.node.name
                value: ${env:NODE_NAME}
          resource/targetallocator:
            attributes:
              - action: upsert
                key: k8s.node.name
                value: ${env:NODE_NAME}
        receivers:
          filelog:
            exclude:
              - /var/log/pods/${env:POD_NAMESPACE}_nktp-*-collector-*_*/*/*.log
            include:
              - /var/log/pods/*/*/*.log
            include_file_path: true
            operators:
              - type: container
            retry_on_failure:
              enabled: true
              max_elapsed_time: 0
            start_at: end
          hostmetrics:
            collection_interval: 1m
            root_path: /hostfs
            scrapers:
              process:
                resource_attributes:
                  process.command_line:
                    enabled: false
          prometheus:
            config:
              scrape_configs: []
          prometheus/targetallocator:
            config:
              scrape_configs:
                - job_name: nktp-targetallocator
                  kubernetes_sd_configs:
                    - namespaces:
                        names:
                          - ${env:POD_NAMESPACE}
                      role: pod
                      selectors:
                        - field: spec.nodeName=${env:NODE_NAME}
                          label: app.kubernetes.io/name=nktp-daemonset-targetallocator,app.kubernetes.io/component=opentelemetry-targetallocator
                          role: pod
                  relabel_configs:
                    - action: keep
                      regex: http
                      source_labels:
                        - __meta_kubernetes_pod_container_port_name
                    - source_labels:
                        - __meta_kubernetes_pod_name
                      target_label: instance
                  scrape_interval: 30s
        service:
          extensions:
            - health_check
          pipelines:
            logs:
              exporters:
                - otlp_http/logs
              processors:
                - memory_limiter
                - resource/node
              receivers:
                - filelog
            metrics:
              exporters:
                - otlp_http/metrics
              processors:
                - memory_limiter
                - resource/node
              receivers:
                - prometheus
                - hostmetrics
            metrics/targetallocator:
              exporters:
                - otlp_http/watchdog
              processors:
                - memory_limiter/targetallocator
                - resource/targetallocator
              receivers:
                - prometheus/targetallocator
          telemetry:
            logs:
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
            metrics:
              readers:
                - periodic:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
            resource:
              k8s.node.name: ${env:NODE_NAME}
              service.name: nktp-daemonset
            traces:
              processors:
                - batch:
                    exporter:
                      otlp:
                        endpoint: http://nktp-watchdog-collector:4318
                        protocol: http/protobuf
      env:
        - name: GOMEMLIMIT
          value: 448MiB
        - name: GOGC
          value: "50"
        - name: NODE_NAME
          valueFrom:
            fieldRef:
              fieldPath: spec.nodeName
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
      image: otel/opentelemetry-collector-k8s:0.159.0
      managementState: managed
      mode: daemonset
      podSecurityContext:
        seccompProfile:
          type: RuntimeDefault
      resources:
        limits:
          cpu: 500m
          memory: 512Mi
        requests:
          cpu: 100m
          memory: 256Mi
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop:
            - ALL
        readOnlyRootFilesystem: true
        runAsUser: 0
      targetAllocator:
        allocationStrategy: per-node
        enabled: true
        prometheusCR:
          denyFSAccessThroughSMs: true
          enabled: true
          podMonitorSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: NotIn
                values:
                  - "true"
          probeSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: NotIn
                values:
                  - "true"
          scrapeConfigSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: NotIn
                values:
                  - "true"
          serviceMonitorSelector:
            matchExpressions:
              - key: nktp.nvidia.io/large-target
                operator: NotIn
                values:
                  - "true"
        replicas: 1
      terminationGracePeriodSeconds: 60
      tolerations:
        - operator: Exists
      upgradeStrategy: automatic
      volumeMounts:
        - mountPath: /var/log/pods
          name: pod-logs
          readOnly: true
        - mountPath: /hostfs/proc
          name: host-proc
          readOnly: true
      volumes:
        - hostPath:
            path: /var/log/pods
            type: Directory
          name: pod-logs
        - hostPath:
            path: /proc
            type: Directory
          name: host-proc
